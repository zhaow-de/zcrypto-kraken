# zcrypto engine gate-ops schedule -- a systemd USER timer (spec 00042, workstation gate ops).
# 06:30 UTC daily: by then all of UTC-yesterday's 4h cycles are journaled on the VPS, so the
# pull + verified replay + report cover a complete day. Persistent=true fires a missed run as
# soon as the machine is back up. See zcrypto-engine-gateops.service for the placeholder
# fill-in, the attended-first-pull prerequisite, and the install steps.

[Unit]
Description=Daily 06:30 UTC zcrypto engine gate-ops run

[Timer]
OnCalendar=*-*-* 06:30:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
