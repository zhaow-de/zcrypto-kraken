# zcrypto data-gated tests -- a systemd USER unit template: the whole test suite, nightly, from the
# workstation checkout whose data/ holds the datasets, so every test that skips in CI for want of a
# dataset runs for real. infra/scripts/data-gated-run.py is the runner; the result lands in
# .local/data-gated-runs/latest.json in that checkout, which zcrypto-daily-ops reads. The timer
# beside this file is what gets enabled; the service carries no [Install] section on purpose, so it
# cannot be enabled to run at login by mistake.
#
# Placeholders: <repo>, <uv> and <path> are filled into a COPY by the install below -- this tracked
# file keeps them, and tests/test_systemd_user_units.py reads it with them in place --
#   <repo> = the MAIN zcrypto-kraken checkout, the one with data/ (e.g. /home/you/Projects/zcrypto-kraken)
#   <uv>   = the uv binary (find it with `command -v uv`, e.g. /home/you/.local/bin/uv)
#   <path> = your login PATH. A user unit gets the manager's, which on this workstation is
#            /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin -- it carries jq, bash and sed but
#            NOT nvm's node, so `tests/test_review_workflows.py` found none and the night read clean
#            while the one case that executes `pre-read.js`'s predicate never ran. Re-render after
#            an nvm upgrade: the path carries the node version, and a stale one fails that case.
#
# Prerequisite -- lingering. Without it the user manager stops at logout, the timer sleeps with it,
# and a night nobody was logged in produces no result:
#   loginctl enable-linger $USER
#   loginctl show-user $USER -p Linger    # verify: prints "Linger=yes"
#
# Install, from the main checkout's root -- the render fills the placeholders into the copy under
# ~/.config/systemd/user/, never into this file; the timer has none and is copied as it is:
#   mkdir -p ~/.config/systemd/user
#   sed "s|<repo>|$PWD|; s|<uv>|$(command -v uv)|; s|<path>|$PATH|" infra/systemd/zcrypto-data-gated-tests.service > ~/.config/systemd/user/zcrypto-data-gated-tests.service
#   cp infra/systemd/zcrypto-data-gated-tests.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now zcrypto-data-gated-tests.timer
#   systemctl --user list-timers zcrypto-data-gated-tests.timer    # confirm: NEXT is tonight
#   systemctl --user start --no-block zcrypto-data-gated-tests.service   # a first run by hand, so tomorrow's read has a file; returns at once
#   journalctl --user -u zcrypto-data-gated-tests.service -f       # follow it; the last line names the files written

[Unit]
Description=zcrypto data-gated tests: the whole suite nightly from the workstation checkout

[Service]
Type=oneshot
WorkingDirectory=<repo>
Environment=PATH=<path>
ExecStart=<uv> run python infra/scripts/data-gated-run.py
