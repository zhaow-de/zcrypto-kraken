          },
          "expr": "sum by (host, container) (count_over_time({host=\"ops\", container=~\"zcrypto-.*\", level=~\".+\"} [26h])) or on() vector(0)",
          "refId": "F",
          "legendFormat": "dead-man · ops units, leveled lines (26h) {{container}}",
          "queryType": "range",
          "step": "1h"
        },
        {
          "datasource": {
            "type": "loki",
