    {
      "id": 104,
      "type": "table",
      "title": "Last line seen — per stream",
      "description": "A rate of zero and a stream that never existed render identically on a graph. This table tells them apart: a row present with an old timestamp is a stream that has gone quiet, a row missing entirely is a stream that has produced no line in twenty-six hours — the widest window any log rule evaluates, so a stream missing here is already past every rule's patience. Streams that exist on only one machine are expected to be missing from the other, and the edge machine ships metrics only, so it never appears here at all. Context panel, carrying no threshold of its own — the page pointers sit on the panel beside it, which plots the rules' own counts.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "max by (host, container) (max_over_time({host=~\"$host\", container=~\"$container\"} | label_format seen=`{{ unixEpoch __timestamp__ }}` | unwrap seen [26h])) * 1000",
          "refId": "A",
          "legendFormat": "last line seen",
          "queryType": "instant",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "host": "Machine",
              "container": "Stream",
              "Value": "Last line seen"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "no selected stream has shipped a line in the last 26h"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 1,
      "type": "logs",
      "title": "Logs — $container / $level",
      "description": "Every line, newest first. The capture daemon, the trading engine and the liquidations poller push straight to the log store as one JSON object per record, so their lines are unpacked here at query time and rendered as the message alone, with any stack trace beneath it. Lines collected from the systemd journal and from the shipping agent itself were already unpacked when they were collected and pass through untouched — the fallback in this panel's query is what keeps them readable. Level is a real stream label on both paths, so filtering and colouring work the same way for all of them. Expand a row to see the logger, the source file and any structured fields the line carried.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 24,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "A",
          "queryType": "range",
          "expr": "{host=~\"$host\", container=~\"$container\", level=~\"$level\"} |= \"$search\" | json | drop __error__, __error_details__ | line_format \"{{ if .message }}{{ .message }}{{ if .exception }}\\n{{ .exception }}{{ end }}{{ else }}{{ __line__ }}{{ end }}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "1m",
