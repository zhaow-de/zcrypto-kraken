            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (host) (count_over_time({host=\"ops\", container=\"alloy\", level=~\".+\"} [6h])) or on() vector(0)",
          "refId": "D",
          "legendFormat": "dead-man · shipping agent's own stream, ops (6h)",
          "queryType": "range",
          "step": "1h"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (host) (count_over_time({host=\"ops\", container=\"liquidations\", level=~\".+\"} [6h])) or on() vector(0)",
          "refId": "E",
          "legendFormat": "dead-man · liquidations poller (6h)",
          "queryType": "range",
          "step": "1h"
