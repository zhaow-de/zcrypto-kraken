# Rendered by the `access` Ansible role at /etc/default/alloy (spec 00075 D11) -- do not hand-edit
# on the host, it is overwritten on the next converge. Edit
# infra/ansible/roles/access/templates/alloy-env.j2 instead. The apt package's alloy.service reads
# this file as EnvironmentFile=/etc/default/alloy: CONFIG_FILE and CUSTOM_ARGS are the unit's own
# knobs (the deb's shipped defaults), the GRAFANA_* and MON_* creds below are consumed by
# config.alloy's `sys.env(...)` calls. The six GRAFANA_* names come straight from
# group_vars/observed/vault.yml, as roles/ops/templates/alloy-secrets.env.j2 renders them for the
# container variant -- no hand-placed out-of-band copy exists anywhere; the three MON_PROM_* names
# are the node's leg, from group_vars/observed/vars.yml and the vault's mon_ingest_fleet_password.
# No MON_LOKI_* here: this host ships no logs. tests/test_infra_alloy_series.py holds the lines
# below by literal and the names to config.alloy's `sys.env(...)` calls.
CONFIG_FILE="/etc/alloy/config.alloy"
CUSTOM_ARGS=""
GRAFANA_PROM_URL={{ grafana_prom_url }}
GRAFANA_PROM_USERNAME={{ grafana_prom_user }}
GRAFANA_PROM_PASSWORD={{ grafana_prom_token }}
GRAFANA_LOKI_URL={{ grafana_loki_url }}
GRAFANA_LOKI_USERNAME={{ grafana_loki_user }}
GRAFANA_LOKI_PASSWORD={{ grafana_loki_token }}
MON_PROM_URL={{ mon_ingest_prom_url }}
MON_PROM_USERNAME={{ mon_ingest_fleet_user }}
MON_PROM_PASSWORD={{ mon_ingest_fleet_password }}
