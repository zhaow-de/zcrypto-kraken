# Rendered by the `access` Ansible role at /etc/systemd/system/zaccess-probe.timer — do not
# hand-edit on the host, edit infra/ansible/roles/access/templates/zaccess-probe.timer.j2 instead.
# Traceability: spec 00075 D11
[Unit]
Description=Access-edge probe cadence — every 5 minutes

[Timer]
OnCalendar=*:2/5:11
# Deliberately NO Persistent=true, same reasoning as the capture reboot-check timer: this reports
# CURRENT state (handshake age computed against `date +%s` at run time, cert notAfter re-read live)
# -- a cycle missed while the host was down is meaningless to catch up on, and the next slot is at
# most 5 min away.
Unit=zaccess-probe.service

[Install]
WantedBy=timers.target
