// Grafana Alloy config for the internet bridgehead's telemetry (spec 00075 D11). Installed by the
// `access` Ansible role via `ansible.builtin.copy` at /etc/alloy/config.alloy -- do not hand-edit
// on the host, it is overwritten on the next converge (UNGATED: unlike the ops/capture/NAS copies,
// this one carries no digest gate, so every converge ships it -- that IS the drift remedy here,
// deliberately, no separate assert task). Edit infra/ansible/roles/access/files/config.alloy
// instead -- files/, NOT templates/: `copy:` only ever searches a role's files/ dir
// (tests/test_infra_alloy_series.py records the lesson from the ops config; a converge proved it
// there, no syntax check could).
//
// NATIVE Alloy (apt package, D11), NOT the container variant every other host in this fleet runs
// (roles/ops/files/config.alloy, roles/capture/files/config.alloy, infra/nas/config.alloy) --
// two structural consequences, called out where they land below:
//   1. No /host/proc, /host/sys, /host/root rootfs remapping in the unix exporter: this process
//      reads the host's REAL /proc, /sys, / directly, so procfs_path/sysfs_path/rootfs_path are
//      simply omitted (they exist only to compensate for a container's own separate mount
//      namespace, which does not apply here).
//   2. Credentials arrive via /etc/default/alloy (the deb package's systemd unit reads it as
//      EnvironmentFile=), rendered by alloy-env.j2 from the SAME six group_vars/observed vault
//      vars (grafana_prom_url/grafana_prom_user/grafana_prom_token/grafana_loki_url/
//      grafana_loki_user/grafana_loki_token) that roles/ops/templates/alloy-secrets.env.j2 uses --
//      read here via the same `sys.env(...)` idiom every other host's config uses.
//
// Metrics only: this host ships no logs pipeline. It runs no journal-worthy daemons of its own
// (no `--ship-logs` app, no docker containers), so there is nothing here mirroring the
// loki.relabel/loki.source.journal/loki.process/loki.write blocks the container configs carry --
// adding them would be machinery with no source to read from.

// ---- Host metrics -------------------------------------------------------------------------
prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "loadavg", "meminfo", "filesystem", "netdev", "textfile"]

  textfile {
    // The probe timer's zaccess.prom (zaccess-probe.sh.j2, spec 00075 D11): WireGuard handshake
    // age + edge TLS notAfter per vhost. Native Alloy reads the host's real path directly -- no
    // container bind-mount indirection to a "/textfile" alias like the ops/NAS configs use.
    directory = "/var/lib/zaccess-textfiles"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.remote_write.grafana.receiver]
  scrape_interval = "60s"
}

// ---- Scrape -> remote_write ------------------------------------------------------------------
prometheus.remote_write "grafana" {
  // `host="zaccess"` on every metric this component ships -- the `Fleet · Alloy dark` rule
  // (infra/grafana/alerts.yaml) and Step 8's post-converge verify both select on it, exactly like
  // every other host's external_labels.
  external_labels = {
    host = "zaccess",
  }

  endpoint {
    url = sys.env("GRAFANA_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_PROM_USERNAME")
      password = sys.env("GRAFANA_PROM_PASSWORD")
    }

    // Series minimization (00043), the same two-stage shape as every other host: drop Alloy's own
    // `go_*` self-metrics first (the embedded unix-exporter HTTP handler's default Go/process
    // collectors, present even with no `prometheus.exporter.self` component on this host) --
    // `alloy_*` is kept in the drop pattern for parity with the other configs even though nothing
    // here would currently emit it. Then keep-only the host + textfile series this stack actually
    // wants. T0051: a `keep` action drops everything it does not list, so a series missing here
    // does not merely go undashboarded -- it does not exist. `node_textfile_mtime_seconds` and
    // `node_textfile_scrape_error` are the did-the-timer-RUN discriminators (the ops
    // green-when-blind lesson, 2026-07-28): without them a dead probe timer serves its last gauges
    // forever and the tunnel-stale/cert alerts can never fire.
    write_relabel_config {
      source_labels = ["__name__"]
      regex         = "go_.*|alloy_.*"
      action        = "drop"
    }

    write_relabel_config {
      source_labels = ["__name__"]
      regex         = "up|node_cpu_seconds_total|node_load1|node_memory_MemAvailable_bytes|node_memory_MemTotal_bytes|node_filesystem_avail_bytes|node_filesystem_size_bytes|node_network_receive_bytes_total|node_network_transmit_bytes_total|node_textfile_mtime_seconds|node_textfile_scrape_error|zaccess_wireguard_handshake_age_seconds|zaccess_tls_not_after_seconds"
      action        = "keep"
    }
  }
}
