# Managed by the `access_ops` role (spec 00075 D15) -- hand edits are overwritten by design; change
# infra/ansible/roles/access_ops/templates/tmux.conf.j2 instead.
set -g mouse on
set -g history-limit 10000

# NO `set -g window-size manual` here. It was the D13 resize mitigation, but it CRASHES the tmux 3.5a
# server ("server exited unexpectedly") the next time a session/window is created -- which is exactly
# what killed the live zcrypto session on 2026-07-30 when agentboard created its own session on the
# poisoned server. Verified: `tmux -f <conf-with-window-size-manual> new-session` dies; the same conf
# without that one line is fine; `set -g default-size` alone is harmless. The reflow-on-attach it was
# meant to prevent is RECOVERABLE (the operator's real terminal re-attaches at its own size); the
# crash is not. So the pin is dropped -- never reintroduce `window-size manual` on tmux 3.5a.
