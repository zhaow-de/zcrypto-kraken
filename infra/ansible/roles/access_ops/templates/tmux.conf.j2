# Managed by the `access_ops` role (spec 00075 D15) -- hand edits are overwritten by design; change
# infra/ansible/roles/access_ops/templates/tmux.conf.j2 instead.
set -g mouse on
set -g history-limit 10000

# D13: pin the window size so a differently-sized web client cannot reflow the long-running session.
# default-size MUST match the current live session's measured dimensions (212x53) -- the source-file
# handler applies this live on every converge, and window-size manual alone (without a matching
# default-size) would snap the window to the tmux default 80x24 and reflow the running zcrypto
# session, a catastrophe for a session nothing can rebuild.
set -g default-size 212x53
set -g window-size manual
