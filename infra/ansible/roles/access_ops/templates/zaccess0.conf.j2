# Rendered by the `access_ops` role at /etc/wireguard/zaccess0.conf — edit the template.
[Interface]
Address = 10.99.0.2/24
# The tunnel's IPv4 path from the ops LAN carries at most 1460-byte packets and WireGuard adds 60 over
# IPv4, so wg-quick's default 1420 is fragmented or dropped; 1380 leaves 20 bytes of margin.
MTU = 1380
PrivateKey = {{ zaccess_wg_ops_private_key }}

[Peer]
PublicKey = {{ zaccess_wg_bridgehead_public_key }}
PresharedKey = {{ zaccess_wg_preshared_key }}
# 4.zaccess.zhaow.me has an A record and no AAAA, so the tunnel dials the bridgehead over IPv4 alone.
Endpoint = 4.zaccess.zhaow.me:{{ access_ops_wg_listen_port }}
PersistentKeepalive = 25
AllowedIPs = 10.99.0.1/32
