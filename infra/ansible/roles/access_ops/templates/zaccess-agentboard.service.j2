# zaccess-agentboard.service — rendered by the `access_ops` role. Web terminal onto the operator
# tmux, bound to the tunnel address only (spec 00075 D13, G2). Every converge renders this unit, but
# whether it is enabled/started is gated on access_ops_agentboard_live -- false (the default) drives
# it disabled+stopped every converge, so it cannot go live on its own (nor auto-start on a reboot);
# it goes live only after the owner's D13 spike (a destructive-capability drill against a decoy tmux
# session) passes and the owner flips that flag true. NO built-in auth on agentboard itself -- the
# mTLS edge (spec 00075 D2) is the only control, so this unit only ever needs to be reachable over
# the WireGuard tunnel, never on a public interface.
[Unit]
Description=Web terminal bridge onto the operator tmux, tunnel-bound
Requires=wg-quick@zaccess0.service
After=wg-quick@zaccess0.service

[Service]
User=zhaow
Environment=PORT=4040
Environment=HOSTNAME=10.99.0.2
Environment=TMUX_SESSION=agentboard
Environment=DISCOVER_PREFIXES=zcrypto
# KillMode=process is LOAD-BEARING, not tidiness. agentboard boots the operator's tmux server as a
# child, and a forked process inherits the unit's cgroup for life -- reparenting to init does NOT move
# it out. Under the default KillMode=control-group, `systemctl restart` therefore SIGKILLs the tmux
# server and every operator session with it. That happened: 2026-08-27, four sessions destroyed by a
# restart taken to pick up a version bump. `ppid 1` makes the tmux server look independent; read
# /proc/<pid>/cgroup, never the ppid.
#
# KillMode=process only works because the start script execs the SERVER as MainPID. The `agentboard`
# shim on PATH is a node wrapper that runs the real binary as a CHILD, so with the shim as MainPID
# systemd would kill the wrapper and leave the server holding :4040 -- the next start would fail to
# bind. The script resolves node and the binary at START time, so a node upgrade via nvm still needs
# only `systemctl restart zaccess-agentboard` -- no re-render, no converge (spec 00075 D13) -- and
# that restart no longer costs the operator their sessions.
ExecStart=/usr/local/sbin/zaccess-agentboard-start
KillMode=process
Restart=on-failure

# The cap bounds what KillMode=process above admits: the operator's whole tmux workspace lives in
# this cgroup, so without a limit one runaway takes the HOST rather than the service -- which is what
# happened on 2026-09-15, at 58.4 GiB, on a 62 GiB box.
#
# MemoryHigh is the one that does the work: it throttles and reclaims rather than killing, and the
# runaway passed 12G in well under a second, so back-pressure arrives long before anything dies.
# MemoryMax is the backstop for an allocation faster than reclaim. The gap between them is
# deliberate -- a single figure would kill where throttling would have been enough.
#
# Sized against measurement, not taste: the cgroup's steady draw is ~3.4 GiB, and the headroom above
# it carries a full `uv run pytest` plus concurrent workflow agents inside a web-terminal pane. Do
# not tighten these without re-measuring that peak -- a cap that throttles the normal pass teaches
# the operator to raise it, and a raised cap is the one that is not there when it matters.
MemoryAccounting=yes
MemoryHigh=12G
MemoryMax=24G

[Install]
WantedBy=multi-user.target
