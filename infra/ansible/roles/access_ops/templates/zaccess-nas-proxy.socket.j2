# zaccess-nas-proxy.socket — rendered by the `access_ops` role. Tunnel-side half of the NAS relay
# (spec 00075 D6): systemd-socket-proxyd, no NAT/IP forwarding anywhere. FreeBind=yes so the unit
# binds 10.99.0.2 before the tunnel brings that address up.
[Unit]
Description=NAS relay socket on the ops-side tunnel endpoint
# The tunnel dependency is the service's: an After= on wg-quick here closes a boot ordering cycle
# through sockets.target and basic.target, which systemd breaks by dropping this socket's start job.

[Socket]
ListenStream=10.99.0.2:5001
FreeBind=yes
Accept=no

[Install]
WantedBy=sockets.target
