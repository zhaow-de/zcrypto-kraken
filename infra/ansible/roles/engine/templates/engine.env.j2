# Rendered by the `engine` Ansible role at /opt/zcrypto-engine/engine.env (0600 root-only) — the
# ONLY file that carries the trade key material; the compose file references it via env_file and
# stays secret-free. Do not hand-edit on the host: update the vault and re-converge.
KRAKEN_SPOT_API_KEY={{ kraken_trade_api_key }}
KRAKEN_SPOT_API_SECRET={{ kraken_trade_api_secret }}
HEALTHCHECK_URL={{ engine_healthcheck_url }}
ZCRYPTO_REQUIRE_CONFIG=1
