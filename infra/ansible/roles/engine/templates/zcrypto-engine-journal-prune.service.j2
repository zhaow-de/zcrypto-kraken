# Rendered by the `engine` Ansible role at /etc/systemd/system/zcrypto-engine-journal-prune.service
# — do not hand-edit on the host, edit
# infra/ansible/roles/engine/templates/zcrypto-engine-journal-prune.service.j2 and re-converge.
[Unit]
Description=Prune engine-journal days older than {{ engine_journal_retention_days }} days (spec 00070)

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/zcrypto-engine-journal-prune {{ engine_state_dir }}/journal {{ engine_journal_retention_days }} --textfile {{ engine_textfile_dir }}/engine-journal-prune.prom
# A oneshot has no /metrics endpoint to scrape -- it runs for a second -- so it publishes a .prom
# and Alloy's textfile collector reads it (spec 00071 D1). This unit originally passed no --textfile
# at all, on the reasoning that these hosts ran no collector: true at the time, and the wrong
# conclusion. The fix was to add the reader, not drop the writer, and until it landed this prune was
# observable through NOTHING -- its journald line was not in the journal keep-regex either (T0100).
#
# The script deletes only inside the journal dir. These make that STRUCTURAL rather than a promise:
# a bug in its globs cannot reach any path outside ReadWritePaths -- and this host holds the live
# trade key and the capture spool, neither of which this unit has any business touching.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ engine_state_dir }}/journal {{ engine_textfile_dir }}
