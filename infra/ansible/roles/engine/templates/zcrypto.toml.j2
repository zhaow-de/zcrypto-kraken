# Rendered by the `engine` Ansible role at /opt/zcrypto-engine/zcrypto.toml — do not hand-edit
# on the host, it is overwritten on the next converge. The compose file bind-mounts it read-only
# at /app/zcrypto.toml: /app is the image's WORKDIR and `load_config` reads zcrypto.toml from
# the CWD.
[zcrypto.engine]
# Host-absolute paths — the compose volume maps the state dir to the same path in-container, so
# these are also the container-visible ones.
store_dir = "{{ engine_state_dir }}/store"
journal_dir = "{{ engine_state_dir }}/journal"
exec_enabled = true
# Rendered explicitly so a converge diff shows it, from the backstop's fact over this host's vars.yml; arming also needs the exec/armed file on the host.
exec_armed = {{ engine_exec_armed_in_tree | lower }}
# Rendered explicitly, like exec_armed above, so a converge diff shows it — the blast-radius
# bound on a single plan's total notional.
exec_max_plan_notional_eur = {{ engine_exec_max_plan_notional_eur }}
shadow_nav_eur = {{ engine_shadow_nav_eur }}
settle_delay_secs = {{ engine_settle_delay_secs }}
{% if engine_tracking_band_bps is defined %}
tracking_band_bps = {{ engine_tracking_band_bps }}
{% endif %}

{% if engine_cache_enabled | bool %}
# The engine's cache: enabled from the first boot, every value explicit so a converge diff shows it.
# The password is ZCRYPTO_CACHE_PASSWORD in engine.env, never here.
[zcrypto.engine.cache]
enabled = true
host = "cache-proxy"
port = 6379
username = "engine"
{% endif %}
