# Rendered by the `engine` Ansible role at /opt/zcrypto-engine/zcrypto.toml — do not hand-edit
# on the host, it is overwritten on the next converge. The compose file bind-mounts it read-only
# at /app/zcrypto.toml: /app is the image's WORKDIR and `load_config` reads zcrypto.toml from
# the CWD.
[zcrypto.engine]
# Host-absolute paths — the compose volume maps the state dir to the same path in-container, so
# these are also the container-visible ones.
store_dir = "{{ engine_state_dir }}/store"
journal_dir = "{{ engine_state_dir }}/journal"
exec_enabled = true
shadow_nav_eur = {{ engine_shadow_nav_eur }}
settle_delay_secs = {{ engine_settle_delay_secs }}
