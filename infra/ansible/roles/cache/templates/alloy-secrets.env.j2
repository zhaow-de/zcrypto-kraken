# A cache node's Alloy credentials for Grafana Cloud and the node, rendered by the `cache` role from
# group_vars/observed/vault.yml and vars.yml (the node's two URLs and its user), group_vars/cache_host/vault.yml
# (CACHE_EXPORTER_PASSWORD) and group_vars/all/vault.yml (CACHE_SENTINEL_REQUIREPASS, which the engine host's
# proxy reads too); do not hand-edit on the host.
# The names must match config.alloy's `sys.env(...)` calls: tests/test_infra_alloy_series.py holds the two sets
# equal and the GRAFANA_* and MON_* lines by literal.
GRAFANA_PROM_URL={{ grafana_prom_url }}
GRAFANA_PROM_USERNAME={{ grafana_prom_user }}
GRAFANA_PROM_PASSWORD={{ grafana_prom_token }}
GRAFANA_LOKI_URL={{ grafana_loki_url }}
GRAFANA_LOKI_USERNAME={{ grafana_loki_user }}
GRAFANA_LOKI_PASSWORD={{ grafana_loki_token }}
CACHE_EXPORTER_PASSWORD={{ cache_exporter_password }}
CACHE_SENTINEL_REQUIREPASS={{ cache_sentinel_requirepass }}
MON_PROM_URL={{ mon_ingest_prom_url }}
MON_PROM_USERNAME={{ mon_ingest_fleet_user }}
MON_PROM_PASSWORD={{ mon_ingest_fleet_password }}
MON_LOKI_URL={{ mon_ingest_loki_url }}
MON_LOKI_USERNAME={{ mon_ingest_fleet_user }}
MON_LOKI_PASSWORD={{ mon_ingest_fleet_password }}
