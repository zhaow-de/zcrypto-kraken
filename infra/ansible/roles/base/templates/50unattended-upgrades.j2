# Managed by Ansible (roles/base) — do not edit by hand.

Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename},label=Debian-security";
};
{% if base_unattended_upgrades_package_blacklist %}

Unattended-Upgrade::Package-Blacklist {
{% for package in base_unattended_upgrades_package_blacklist %}
        "{{ package }}";
{% endfor %}
};
{% endif %}

Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";

Unattended-Upgrade::Automatic-Reboot "{{ base_unattended_upgrades_automatic_reboot }}";
Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
Unattended-Upgrade::Automatic-Reboot-Time "{{ base_unattended_upgrades_reboot_time }}";

Unattended-Upgrade::Mail "{{ base_unattended_upgrades_mail_to }}";
Unattended-Upgrade::MailOnlyOnError "true";
