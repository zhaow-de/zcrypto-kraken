# The NAS stack's deploy-time env — RENDERED BY ANSIBLE (roles/nas/templates/env.j2, values from
# infra/ansible/host_vars/nas) — do not hand-edit on the NAS, the next converge overwrites it.
# The two image pins fill compose.yaml's ${...:?} placeholders, so compose refuses to start
# without them.
CAPTURE_IMAGE={{ nas_capture_image }}
ALLOY_IMAGE={{ nas_alloy_image }}
CAPTURE_SOURCE={{ nas_capture_source }}
ARCHIVE_SSH_PORT={{ nas_archive_ssh_port }}
JOURNAL_SOURCE={{ nas_journal_source }}
CAPTURE_RED_SOURCE={{ nas_capture_red_source }}
LIQUIDATIONS_SOURCE={{ nas_liquidations_source }}
LIQUIDATIONS_SSH_PORT={{ nas_liquidations_ssh_port }}
PANEL_SOURCE={{ nas_panel_source }}
PANEL_SSH_PORT={{ nas_panel_ssh_port }}
RECONCILED_SOURCE={{ nas_reconciled_source }}
RECONCILED_SSH_PORT={{ nas_reconciled_ssh_port }}
HOT_SOURCE={{ nas_hot_source }}
HOT_SSH_PORT={{ nas_hot_ssh_port }}
HC_BACKUP_SOURCE={{ nas_hc_backup_source }}
GATE_HEALTHCHECK_URL={{ nas_gate_healthcheck_url }}
ARCHIVE_PULL_HASH_SCOPE={{ nas_archive_pull_hash_scope }}
