# Grafana Cloud credentials for the NAS's Alloy container, rendered by the `nas` role from
# group_vars/observed/vault.yml (the NAS joined `observed` when it came under Ansible — T0056; the
# hand-placed out-of-band file this replaces is dead) — do not hand-edit on the NAS, it is
# overwritten on the next converge. Names must match infra/nas/config.alloy's `sys.env(...)` calls
# exactly — the same six names the ops role's alloy-secrets.env.j2 renders; nothing tests this
# file, so a rename here silently breaks remote_write/loki.write with no failure to catch it.
GRAFANA_PROM_URL={{ grafana_prom_url }}
GRAFANA_PROM_USERNAME={{ grafana_prom_user }}
GRAFANA_PROM_PASSWORD={{ grafana_prom_token }}
GRAFANA_LOKI_URL={{ grafana_loki_url }}
GRAFANA_LOKI_USERNAME={{ grafana_loki_user }}
GRAFANA_LOKI_PASSWORD={{ grafana_loki_token }}
