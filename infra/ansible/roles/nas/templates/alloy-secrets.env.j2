# Grafana Cloud's and the node's ingest credentials for the NAS's Alloy container, rendered by the
# `nas` role from group_vars/observed/ — vault.yml for the secrets, vars.yml for the node's two URLs
# and its user (the NAS joined `observed` when it came under Ansible — T0056; the hand-placed
# out-of-band file this replaces is dead) — do not hand-edit on the NAS, it is overwritten on the
# next converge. Names must match infra/nas/config.alloy's `sys.env(...)` calls exactly —
# tests/test_infra_alloy_series.py holds the GRAFANA_* and MON_* lines by literal and the rendered
# names to the config's reads.
GRAFANA_PROM_URL={{ grafana_prom_url }}
GRAFANA_PROM_USERNAME={{ grafana_prom_user }}
GRAFANA_PROM_PASSWORD={{ grafana_prom_token }}
GRAFANA_LOKI_URL={{ grafana_loki_url }}
GRAFANA_LOKI_USERNAME={{ grafana_loki_user }}
GRAFANA_LOKI_PASSWORD={{ grafana_loki_token }}
MON_PROM_URL={{ mon_ingest_prom_url }}
MON_PROM_USERNAME={{ mon_ingest_fleet_user }}
MON_PROM_PASSWORD={{ mon_ingest_fleet_password }}
MON_LOKI_URL={{ mon_ingest_loki_url }}
MON_LOKI_USERNAME={{ mon_ingest_fleet_user }}
MON_LOKI_PASSWORD={{ mon_ingest_fleet_password }}
