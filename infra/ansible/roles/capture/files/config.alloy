// Grafana Alloy config for a capture host's telemetry stack (spec 00057; T0020's first-time
// telemetry stand-up on the capture VPSes). Installed by the `capture` Ansible role via
// `ansible.builtin.copy` at capture_alloy_dir/config.alloy -- do not hand-edit on the host, it is
// overwritten on the next converge. Edit infra/ansible/roles/capture/files/config.alloy instead --
// files/, NOT templates/: `copy:` only ever searches a role's files/ dir, so an edit made to a
// templates/ copy silently never deploys (tests/test_infra_alloy_series.py records the lesson for
// the ops copy; a converge proved it, no syntax check could).
//
// Plain `copy:`, not `template:` -- this file's pipeline stages further down use Go template `{{ }}`
// syntax (loki.process's stage.template blocks, e.g. `{{ ToUpper .Value }}`) that Jinja2 would try
// to evaluate and fail on. The ONE value that would otherwise want per-host parameterisation -- the
// `host` label, which differs between zcrypto and zcrypto-red -- is instead read at RUNTIME from
// `constants.hostname` (Alloy's stdlib host-name constant), so a single static file labels correctly
// on both hosts with no Jinja. Under `network_mode: host` (alloy-compose.yaml.j2) the container
// shares the host UTS namespace -- Docker even refuses `--hostname` in that mode -- so
// `constants.hostname` returns the host's own name, which the base role sets distinctly per host
// (`zcrypto` / `zcrypto-red`, host_vars/zcrypto-red overrides base_hostname). Grafana Cloud
// credentials are NOT in this file: they arrive as environment variables from a rendered, 0600,
// never-committed secrets file (alloy-secrets.env.j2), read here via the `sys.env(...)` stdlib
// function -- the same six names the ops and nas Alloy copies read.

// ---- Host metrics -------------------------------------------------------------------------
// The three alternate-path RO mounts (alloy-compose.yaml.j2: /proc->/host/proc, /sys->/host/sys,
// /->/host/root) let this exporter see the capture host's own /proc, /sys and rootfs without
// colliding with Alloy's own container /proc//sys.
//
// NO textfile collector here (the ops/nas copies keep one): the capture hosts publish no
// node-exporter textfile .prom -- there is no gate/replay/archive timer on them -- so the collector
// and its /textfile mount are both dropped. free disk space (`filesystem`) IS kept: the capture
// spool fills toward the prune horizon and disk-full is the classic capture-killer.
prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "loadavg", "meminfo", "filesystem", "netdev"]

  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"
}

// ---- Container metrics: intentionally NOT collected -----------------------------------------
// cadvisor is omitted (the capture hosts are Debian with a normal cgroup hierarchy, so it would
// work) BY CHOICE, not by constraint: this stack's job is host health + the capture/prune logs
// reaching Grafana; container CPU/mem is not part of that, and cadvisor's series would eat into the
// active-series budget (00043). A future task can add it if a container-level gate ever needs it.

// ---- Scrape -> remote_write ------------------------------------------------------------------
// T0048 defect 1's SD-wedge detection RETIRED with `discovery.docker` (D6/D8): the alert it fed
// (zcrypto-alloy-docker-sd-wedged) watched prometheus_sd_refresh_duration_seconds_count /
// _failures_total, which only this self-scrape ever produced -- with no discovery.* component left
// on this host, neither series exists any more, and both are gone from the keep-regex below too (a
// keep-list entry for a series that cannot exist is the T0051 trap). The drop rule below still
// discards go_/process_/alloy_, so this target's only surviving contribution is its own `up`.
prometheus.exporter.self "alloy" {}

prometheus.scrape "host" {
  targets         = array.concat(prometheus.exporter.unix.host.targets, prometheus.exporter.self.alloy.targets)
  forward_to      = [prometheus.remote_write.grafana.receiver]
  scrape_interval = "60s"
}

prometheus.remote_write "grafana" {
  // `host="<this host>"` on every metric this component ships, from the runtime hostname (see the
  // file header) -- so zcrypto and zcrypto-red are distinguishable in Grafana and a per-host alert
  // selector (`node_load1{host="zcrypto-red"}`) resolves. `external_labels` is applied
  // component-wide, before the write_relabel_config blocks below run -- so it does not touch the
  // drop/keep pair (both match on `__name__` only).
  external_labels = {
    host = constants.hostname,
  }

  endpoint {
    url = sys.env("GRAFANA_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_PROM_USERNAME")
      password = sys.env("GRAFANA_PROM_PASSWORD")
    }

    // Series minimization (00043): drop Alloy's own self-metrics first (defense in depth -- nothing
    // scraped above is Alloy's own /metrics endpoint, so this is normally a no-op), then keep-only
    // the host series this stack wants. A `keep` action drops everything it does not list, so a
    // series missing here does not merely go undashboarded -- it does not exist (T0051). This host
    // publishes only the unix-exporter host metrics: no textfile series (no collector), no
    // ops_*/reconcile/trade-backfill families (those are the ops node's).
    write_relabel_config {
      source_labels = ["__name__"]
      regex         = "go_.*|process_.*|alloy_.*"
      action        = "drop"
    }

    write_relabel_config {
      source_labels = ["__name__"]
      regex         = "up|node_load1|node_load5|node_load15|node_memory_MemTotal_bytes|node_memory_MemAvailable_bytes|node_memory_MemFree_bytes|node_filesystem_avail_bytes|node_filesystem_size_bytes|node_filesystem_free_bytes|node_network_receive_bytes_total|node_network_transmit_bytes_total|node_cpu_seconds_total|node_scrape_collector_success|node_scrape_collector_duration_seconds"
      action        = "keep"
    }
  }
}

// ---- Logs: the host journal -- host-side units AND Alloy's own container ---------------------
// Two unrelated sources share this one journal reader (D6, the docker-socket residual retired):
// the segment-prune oneshot (zcrypto-capture-prune.service) runs a bash script under systemd, not
// a container, so the journal is its ONLY transport; and Alloy's OWN container logs, via the
// journald logging driver (alloy-compose.yaml.j2) -- there is no docker-socket path left on this
// host to carry them instead, so the journal is their only transport too now.
//
// zcrypto-capture.service (the daemon's own systemd wrapper) is deliberately NOT kept here: that
// unit runs `docker compose up` ATTACHED, so the capture container's stdout also flows into ITS
// journal -- and the capture daemon now ships its OWN logs straight to Grafana Cloud (--ship-logs,
// D3) rather than through Alloy at all, so admitting it here would double-ingest for no reason.
loki.relabel "journal_units" {
  // Rules-only component: `forward_to` is a required argument, but nothing streams THROUGH this
  // component -- loki.source.journal below consumes its exported rules via `relabel_rules`.
  forward_to = []

  // KEEP the prune unit's journal lines (source 1: __journal__systemd_unit) OR Alloy's own
  // journald-driver stream (source 2: __journal_container_name = grafana-alloy, the container_name
  // the alloy compose service sets) -- everything else on the host journal (sshd, cron, dockerd,
  // ...) stays local.
  rule {
    source_labels = ["__journal__systemd_unit", "__journal_container_name"]
    separator     = ";"
    regex         = "zcrypto-capture-prune\\.service;.*|.*;grafana-alloy"
    action        = "keep"
  }

  // Unit name minus ".service" -> the `container` label. For the prune unit that yields
  // "zcrypto-capture-prune". Alloy's journald-driver entries carry _SYSTEMD_UNIT=docker.service
  // (journald stamps the SENDING process's unit -- dockerd), so this rule sets container="docker"
  // for them, which the next rule overwrites. That is why the order below is load-bearing.
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(.+)\\.service"
    target_label  = "container"
    replacement   = "$1"
  }

  // Alloy's own stream -> container="alloy" (the parse stage below's `{container="alloy"}`
  // selector keys on this). MUST come after the unit-name rule above -- relabel rules apply in
  // order, each seeing the previous rule's output, and the unit-name rule must run first wherever
  // both fields could ever be populated on the same stream.
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "grafana-alloy"
    target_label  = "container"
    replacement   = "alloy"
  }

  // `host="<this host>"` from the runtime hostname (see the file header) -- one label scheme
  // across the metrics path (external_labels above) and this log transport.
  rule {
    target_label = "host"
    replacement  = constants.hostname
  }
}

loki.source.journal "capture_units" {
  // The compose file mounts the host's persistent journal here read-only; journal readers also need
  // the host's /etc/machine-id (mounted alongside) to resolve the current boot's files
  // (/var/log/journal/<machine-id>/...).
  path          = "/host/journal"
  relabel_rules = loki.relabel.journal_units.rules
  forward_to    = [loki.process.parse.receiver]

  // After an Alloy outage this component resumes from its saved cursor but never reads further back
  // than max_age -- UNSET it defaults to 7h, so a longer outage would permanently skip the window
  // between the cursor and now-7h. 48h was sized for the prune unit alone (one low-volume daily
  // run); this reader now also carries Alloy's own journald-driver stream (D6), so a restart after
  // an outage backfills up to 48h of that too -- still a bounded, one-time replay, not a
  // steady-state cost, so the same ceiling stands.
  max_age       = "48h"
}

// Parse ONCE, here at ingest -- never at query time. One stage now: Alloy's own logfmt output.
// The capture daemon's own Python-timestamped lines had a stage here too, but the docker log path
// that carried them into this pipeline is gone (D6) -- the capture container now ships its OWN
// logs straight to Grafana Cloud (--ship-logs, D3), never through Alloy, so nothing on this host
// would ever match that selector again. The prune unit's bash lines fall through this component
// unmatched by the stage below (no selector here admits them), keeping their journal capture time
// and no level label, same as before.
loki.process "parse" {
  forward_to = [loki.write.grafana.receiver]

  // Alloy's own logs are logfmt: `ts=<t> level=<lvl> msg="<text>" k=v k=v ...`, arriving via the
  // journald logging driver (D6). `{container="alloy"}` matches because the journal_units
  // container-name rule above relabels CONTAINER_NAME=grafana-alloy to container="alloy".
  stage.match {
    selector = "{container=\"alloy\"}"

    stage.logfmt {
      mapping = { "level" = "" }
    }

    stage.template {
      source   = "level"
      template = "{{ if eq .Value \"warn\" }}WARNING{{ else if eq .Value \"fatal\" }}CRITICAL{{ else }}{{ ToUpper .Value }}{{ end }}"
    }

    stage.labels {
      values = { level = "level" }
    }

    // No stage.output: the line ships UNMODIFIED. Unlike the old regex-and-reassemble approach,
    // this keeps every logfmt attribute in the body (msg= plus whatever k=v pairs followed), and a
    // non-logfmt line (a panic, a bare traceback) simply passes through with no `level` label rather
    // than being mangled by a stage that assumed logfmt shape.
  }
}

loki.write "grafana" {
  endpoint {
    url = sys.env("GRAFANA_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_LOKI_USERNAME")
      password = sys.env("GRAFANA_LOKI_PASSWORD")
    }
  }
}
