# The zcrypto CLI's own Loki push credentials for the observability node (spec 00068 D5), rendered
# by the `capture` role from group_vars/observed/ -- vars.yml for the URL and the user, vault.yml for
# the password -- do not hand-edit on the host, it is overwritten on the next converge. Consumed by
# the CAPTURE CONTAINER's `--ship-logs` path (compose.yaml.j2's `env_file`), NOT by Alloy -- see
# alloy-secrets.env.j2 for Alloy's own credentials.
# The URL is the node's Loki push path, the one Alloy's MON_LOKI_URL names; the user and password
# are the node's `logship` user's, which the edge admits on the Loki path alone, so revoking that
# password leaves the `fleet` user's ingest untouched.
# Names must match cli/__main__.py's `_LOKI_ENV_NAMES` exactly -- env_file passes them straight
# through with no translation, and no test compares the two; tests/test_infra_compose_templates.py
# holds these lines to its own literal copy.
ZCRYPTO_LOKI_URL={{ mon_ingest_loki_url }}
ZCRYPTO_LOKI_USERNAME={{ mon_ingest_logship_user }}
ZCRYPTO_LOKI_PASSWORD={{ mon_ingest_logship_password }}
# ZCRYPTO_SHIP_LOGS lives HERE, not in compose.yaml.j2's `environment:` (Minor-1, 00068 T4/T5
# review): compose's env_file reference is `required: false`, so file present -> all four vars ->
# ships; file ABSENT (a converge landing before the vault carries the token) -> the flag is absent
# too -> the ENTRYPOINT omits --ship-logs and capture starts normally on stdout only. If the flag
# instead lived in `environment:`, `required: false` alone would NOT be enough to make the
# missing-file case safe: ZCRYPTO_SHIP_LOGS=1 would still be set with the creds missing, and the
# CLI would raise BadParameter on startup and crash-loop identically.
ZCRYPTO_SHIP_LOGS=1
