# The zcrypto CLI's own Grafana Cloud Loki push credentials (spec 00068 D5), rendered by the
# `capture` role from group_vars/observed/vault.yml -- do not hand-edit on the host, it is
# overwritten on the next converge. Consumed by the CAPTURE CONTAINER's `--ship-logs` path
# (compose.yaml.j2's `env_file`), NOT by Alloy -- see alloy-secrets.env.j2 for Alloy's own copy,
# a distinct token so the app's push can be revoked without blinding fleet telemetry.
# Only ZCRYPTO_LOKI_PASSWORD is a distinct credential (logship_loki_token, access policy
# `zcrypto-app-logship`, scope logs:write only): the URL and USERNAME are properties of the
# Grafana Cloud stack, not of the token, so they are reused from grafana_loki_url /
# grafana_loki_user -- the same values alloy-secrets.env.j2 renders. One value to rotate, nothing
# to drift.
# Names must match cli/__main__.py's `_LOKI_ENV_NAMES` exactly -- env_file passes them straight
# through with no translation, so a rename here silently breaks --ship-logs with no test to catch it.
ZCRYPTO_LOKI_URL={{ grafana_loki_url }}
ZCRYPTO_LOKI_USERNAME={{ grafana_loki_user }}
ZCRYPTO_LOKI_PASSWORD={{ logship_loki_token }}
