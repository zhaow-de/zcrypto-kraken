# Rendered by the `capture` Ansible role at /opt/zcrypto-capture/compose.yaml — do not
# hand-edit on the host, it is overwritten on the next converge. Edit
# infra/ansible/roles/capture/templates/compose.yaml.j2 (and its standalone reference
# counterpart infra/docker/compose.yaml) instead.
# Manual `docker compose` invocations against this file must run as root (Minor-6, 00068 T4/T5
# review): logship-secrets.env is 0600 root:root, so a habitual non-sudo `docker compose -f
# /opt/zcrypto-capture/compose.yaml up -d` (zcrypto-deploy is in the docker group) fails reading it.
services:
  capture:
    image: "{{ capture_image }}@{{ capture_image_digest }}"
    container_name: zcrypto-capture
    restart: unless-stopped
    user: "{{ capture_uid }}:{{ capture_gid }}"
    environment:
      CAPTURE_DATA_DIR: "{{ capture_data_dir }}"
      CAPTURE_DEPTH: "{{ capture_depth }}"
      CAPTURE_PAIRS: "{{ capture_pairs | join(',') }}"
      HEALTHCHECK_URL: "{{ capture_healthcheck_url }}"
      # Spec 00069 D6: UNGUARDED, unlike the logship block below -- no embargo flag, because
      # env+port without the new image are inert (unknown env var, unpublished port) and the new
      # image without this env is exporter-off. Port 9101 is 00043's pinned value, read by
      # roles/capture/files/config.alloy's `capture_app` scrape job -- change both together.
      ZCRYPTO_METRICS_PORT: "9101"
{% if mon_ingest_logship_password is defined %}
      ZCRYPTO_LOG_HOST: "{{ base_hostname }}"
      ZCRYPTO_LOG_SERVICE: capture
{% endif %}
    # `127.0.0.1:9101:9101` (spec 00069 D3): the security boundary is this HOST-side publish, not
    # an in-container bind -- the exporter binds 0.0.0.0 inside the container (bridge-networked;
    # Docker delivers published-port traffic to eth0, never loopback), so loopback-only here is
    # what keeps `/metrics` off the internet on this trade-adjacent host. nftables untouched.
    ports:
      - "127.0.0.1:9101:9101"
    volumes:
      - "{{ capture_data_dir }}:{{ capture_data_dir }}"
{% if mon_ingest_logship_password is defined %}
    # The CLI's Loki push creds and ZCRYPTO_SHIP_LOGS itself live in logship-secrets.env.j2, never in
    # `environment:` above: with `required: false` a missing file drops the flag with the creds, so
    # capture starts on stdout only rather than crash-looping (that file's own comment says why).
    env_file:
      - path: /opt/zcrypto-capture/logship-secrets.env
        required: false
{% endif %}
    deploy:
      resources:
        limits:
          cpus: "{{ capture_cpu_limit }}"
          memory: "{{ capture_memory_limit }}"
    logging:
      driver: json-file
      options:
        max-size: "{{ capture_log_max_size }}"
        max-file: "{{ capture_log_max_file }}"
