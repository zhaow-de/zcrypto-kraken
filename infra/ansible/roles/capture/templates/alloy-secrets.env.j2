# Grafana Cloud credentials for a capture host's Alloy container (spec 00057; T0020's first-time
# telemetry stand-up on the capture VPSes), rendered by the `capture` role from
# group_vars/observed/vault.yml -- do not hand-edit on the host, it is overwritten on the next
# converge. The SAME six names, from the SAME vault group, that the ops and nas roles already render
# for their own Alloy copies (capture_host is a member of the `observed` group, so these resolve
# here with no inventory/vault change).
# Names must match config.alloy's `sys.env(...)` calls exactly -- tests/test_infra_alloy_series.py
# does not check this file, so a rename here silently breaks remote_write/loki.write with no test
# failure to catch it.
GRAFANA_PROM_URL={{ grafana_prom_url }}
GRAFANA_PROM_USERNAME={{ grafana_prom_user }}
GRAFANA_PROM_PASSWORD={{ grafana_prom_token }}
GRAFANA_LOKI_URL={{ grafana_loki_url }}
GRAFANA_LOKI_USERNAME={{ grafana_loki_user }}
GRAFANA_LOKI_PASSWORD={{ grafana_loki_token }}
