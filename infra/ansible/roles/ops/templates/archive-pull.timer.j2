# Rendered by the `ops` Ansible role at /etc/systemd/system/zcrypto-archive-pull.timer — do not
# hand-edit on the host, edit infra/ansible/roles/ops/templates/archive-pull.timer.j2 instead.
[Unit]
Description=Hourly recurring NAS archive pull (spec 00052 D6)

[Timer]
# Off the hour boundary, ahead of the panel-materialize timer (:22, spec 00052 D6 pull-before-
# materialize ordering) it feeds, clear of the ops reboot window (02:25 UTC), the capture hosts'
# maintenance windows (21:25/22:25 UTC), and the daily replay timers (03:41/05:23). The host
# timezone is UTC (base role).
OnCalendar=*-*-* *:12:00
# A host that was down at :12 pulls on the next boot instead of skipping the hour.
Persistent=true
Unit=zcrypto-archive-pull.service

[Install]
WantedBy=timers.target
