# Rendered by the `ops` Ansible role at /etc/systemd/system/zcrypto-archive-pull.timer — do not
# hand-edit on the host, edit infra/ansible/roles/ops/templates/archive-pull.timer.j2 instead.
[Unit]
Description=Half-hourly overlay-writer cycle (spec 00054/T0058; unit name is historical)

[Timer]
# :12 AND :42 -- T0058 doubled the cadence (consensus #4): reads go through the NFS mount now and
# cost no transfer, so an extra cycle is cheap and halves the writer's reaction lag to a fresh NAS
# pull. Alert thresholds stay as provisioned for the hourly cadence -- deliberately. Both slots are
# off the hour boundary, clear of the ops reboot window (02:25 UTC), the capture hosts' maintenance
# windows (21:25/22:25 UTC), and the daily replay timers (03:41/05:23). Host timezone is UTC (base
# role).
OnCalendar=*-*-* *:12,42:00
# A host that was down at a slot runs on the next boot instead of skipping the cycle.
Persistent=true
Unit=zcrypto-archive-pull.service

[Install]
WantedBy=timers.target
