#!/usr/bin/env bash
# Rendered by the `ops` Ansible role at /usr/local/sbin/zcrypto-grafana-watchdog — do not
# hand-edit on the host, edit infra/ansible/roles/ops/templates/grafana-watchdog.sh.j2 instead.
#
# The dead-man service's half of the mutual watchdog: pings the zcrypto-grafana-watchdog check when
# the Grafana that pages answers and <url>/fail when it does not; if this host or the timer dies the
# ping stops and the check pages by staleness.
# The page of last resort: Grafana and the dead-man service are the two things that page, and neither
# can say both are dark. After BOTH_DARK_AFTER runs in a row with both down this posts to Slack itself,
# and once more when either answers again. Without this host's own internet the post fails and is
# retried on the next run; it stays silent until then.
set -euo pipefail

URL="{{ ops_grafana_watchdog_healthcheck_url }}"
STATE=/var/lib/zcrypto-grafana-watchdog/both-dark
BOTH_DARK_AFTER=3
RUNBOOK="infra/runbooks/observability.md#both-nodes-dark"

probe() { curl -fsS -m 20 --retry 2 --retry-delay 5 -o /dev/null "$1"; }

# The webhook goes through stdin so it is on no process's argv.
post() {
  [ -n "${ZCRYPTO_SLACK_WEBHOOK_URL:-}" ] || return 1
  printf 'url = "%s"\n' "$ZCRYPTO_SLACK_WEBHOOK_URL" |
    curl -fsS -m 20 -o /dev/null -H 'Content-type: application/json' -d "{\"text\":\"$1\"}" -K -
}

mon=up
probe "{{ ops_grafana_watchdog_probe_url }}" || mon=down
hc=up
probe "{{ ops_grafana_watchdog_hc_probe_url }}" || hc=down

# Empty URL skips the ping (the CLI's optional `ping_healthcheck` semantics, shell edition).
if [ -n "$URL" ]; then
  if [ "$mon" = up ]; then
    curl -fsS -m 10 -o /dev/null "$URL" || true
  else
    curl -fsS -m 10 -o /dev/null "$URL/fail" || true
  fi
fi

count=0
paged=0
if [ -r "$STATE" ]; then
  read -r count paged <"$STATE" || true
fi

if [ "$mon" = down ] && [ "$hc" = down ]; then
  count=$((count + 1))
  if [ "$count" -ge "$BOTH_DARK_AFTER" ] && [ "$paged" != 1 ]; then
    if post ":rotating_light: zcrypto-mon and zcrypto-hc are both dark from zcrypto-ops, $count runs in a row: nothing else can page you. Runbook: $RUNBOOK"; then
      paged=1
    fi
  fi
else
  count=0
  if [ "$paged" = 1 ]; then
    if post ":white_check_mark: zcrypto-mon or zcrypto-hc answers zcrypto-ops again (mon $mon, hc $hc). Runbook: $RUNBOOK"; then
      paged=0
    fi
  fi
fi
printf '%s %s\n' "$count" "$paged" >"$STATE"
