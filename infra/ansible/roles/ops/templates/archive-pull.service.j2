# Rendered by the `ops` Ansible role at /etc/systemd/system/zcrypto-archive-pull.service — do not
# hand-edit on the host, edit infra/ansible/roles/ops/templates/archive-pull.service.j2 instead.
# Traceability: spec 00054 / T0058
[Unit]
Description=Overlay writer -- reconcile + daily trade backfill over NFS reads (the unit name is historical)
# Requires/After docker.service (review fix 2026-07-17): both steps are `docker run`s, and the
# timer's Persistent=true boot catch-up can fire before dockerd is up -- without the ordering the
# caught-up run fails on a dead socket. RequiresMountsFor orders the NAS NFS automount
# ({{ ops_nas_mount }}) below this unit, so the gate/reads have a mount to hit.
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
RequiresMountsFor={{ ops_nas_mount }}

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/zcrypto-archive-pull
