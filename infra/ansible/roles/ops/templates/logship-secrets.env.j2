# The zcrypto CLI's Loki push creds, rendered by the `ops` role: a hand edit on the host is overwritten.
# The names are cli/__main__.py's `_LOKI_ENV_NAMES`, which no test compares to these lines.
ZCRYPTO_LOKI_URL={{ mon_ingest_loki_url }}
ZCRYPTO_LOKI_USERNAME={{ mon_ingest_logship_user }}
ZCRYPTO_LOKI_PASSWORD={{ mon_ingest_logship_password }}
# ZCRYPTO_SHIP_LOGS lives HERE for schema parity with the capture role's copy (00068 T4/T5 review
# Minor-1) -- but on THIS host the CLI's --ship-logs flag is baked directly into the liquidations
# service's exec-form entrypoint (compose.yaml.j2), never read from this var: an exec-form
# `entrypoint:` override replaces the image's shell ENTRYPOINT wholesale, so the Dockerfile's
# `${ZCRYPTO_SHIP_LOGS:+--ship-logs}` conveyance never runs for this service. This line is
# therefore inert here (harmless, unread) -- kept only so every logship-secrets.env.j2 in the
# fleet shares one schema. Residual worth knowing: if this file goes missing after a converge
# (compose's env_file `required: false`), the other four vars disappear too, but the entrypoint's
# --ship-logs stays baked in regardless -- so the CLI still raises BadParameter on the missing
# creds and crash-loops. Unlike capture, this host's entrypoint cannot self-heal to no-ship-logs
# at runtime; `required: false` only keeps `docker compose up` itself from refusing to start.
ZCRYPTO_SHIP_LOGS=1
