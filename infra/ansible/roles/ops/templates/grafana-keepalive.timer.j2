# Rendered by the `ops` Ansible role at /etc/systemd/system/zcrypto-grafana-keepalive.timer — do
# not hand-edit on the host, edit infra/ansible/roles/ops/templates/grafana-keepalive.timer.j2
# instead.
[Unit]
Description=Hourly Grafana Cloud keep-alive

[Timer]
# Hourly at a minute no other unit on this host uses -- checked against every timer the ops and
# access_ops roles install, not against a remembered pattern. No
# Persistent=: a slot missed while the host was down is not worth catching up, and a catch-up run
# would answer for a window nobody was awake to keep alive.
OnCalendar=*:37:00
Unit=zcrypto-grafana-keepalive.service

[Install]
WantedBy=timers.target
