# Rendered by the `ops` Ansible role at /etc/systemd/system/zcrypto-grafana-keepalive.timer — do
# not hand-edit on the host, edit infra/ansible/roles/ops/templates/grafana-keepalive.timer.j2
# instead.
[Unit]
Description=Grafana Cloud keep-alive, four times an hour

[Timer]
# Four times an hour, at minutes no timer the ops and access_ops roles install uses -- checked with
# `grep -h OnCalendar infra/ansible/roles/{ops,access_ops}/templates/*.timer.j2`, not against a
# remembered pattern; the host's own OS timers were not part of that check. No
# Persistent=: a slot missed while the host was down is not worth catching up, and a catch-up run
# would answer for a window nobody was awake to keep alive.
OnCalendar=*:02/15:00
Unit=zcrypto-grafana-keepalive.service

[Install]
WantedBy=timers.target
