# Rendered by the `ops` Ansible role at /etc/systemd/system/zcrypto-onchain-guard.service — do not
# hand-edit on the host, edit infra/ansible/roles/ops/templates/onchain-guard.service.j2 instead.
#
# No Requires= on docker.service, so a guard run never pulls docker into its own start transaction; docker.socket may
# still start docker when the guard calls it, as it may for every docker-calling ops timer. No TimeoutStartSec=:
# systemd leaves a oneshot's start timeout disabled, and a run that stops both containers waits up to twice their
# stop grace.
[Unit]
Description=Stop the on-chain node and its index when an ops job's age slips past its bar
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/zcrypto-onchain-guard
