// Grafana Alloy config for the ops node's telemetry stack (spec 00054 D1/D7). Installed by the
// `ops` Ansible role via `ansible.builtin.copy` at ops_alloy_dir/config.alloy -- do not hand-edit
// on the host, it is overwritten on the next converge. Edit
// infra/ansible/roles/ops/templates/config.alloy instead. Structurally this mirrors
// infra/nas/config.alloy (spec 00049 Role B) -- same unix exporter / textfile / scrape /
// remote_write / docker-logs pipeline -- with three deliberate divergences, each called out in
// the comments below. Grafana Cloud credentials are NOT in this file: they arrive as environment
// variables from an out-of-band, 0600, never-committed secrets file (alloy-secrets.env, see
// infra/ops/README.md), read here via the `sys.env(...)` stdlib function -- the same contract as
// the NAS's alloy-secrets.env.
//
// Plain `copy:`, not `template:` (review finding 2) -- this file is 100% static: every value below
// (the keep-regex, the textfile path, the host label) is a literal, identical on every converge,
// so there is nothing for Jinja2 to substitute. A `template:` here would also have forced the
// whole body into a `{% raw %}` wrapper, since Alloy's own pipeline stages further down use Go
// template `{{ }}` syntax (loki.process's stage.template blocks, e.g. `{{ ToUpper .Value }}`) that
// Jinja2 would otherwise try to evaluate and fail on (`ToUpper .Value` is not valid Jinja) -- and a
// full-body raw wrap would silently emit a future `{{ ops_something }}` as a literal string instead
// of failing loudly. If per-host parameterisation is ever genuinely needed, switch this task back
// to `template:` then, and scope `{% raw %}` narrowly to only the `stage.template` blocks that
// actually contain Go syntax -- not the whole file.

// ---- Host metrics -------------------------------------------------------------------------
// The three alternate-path RO mounts (alloy-compose.yaml.j2: /proc->/host/proc, /sys->/host/sys,
// /->/host/root) let this exporter see the ops host's own /proc, /sys and rootfs without colliding
// with Alloy's own container /proc//sys.
//
// DIVERGENCE 2 (user/group + rootfs): the NAS mounts /:/host/root:ro and keeps `filesystem` in
// set_collectors for its rootfs-based free-disk-space reading, while running Alloy as a dedicated
// non-secret-owning uid (1031, not the key-owning 1000) to keep that mount from exposing its 0600
// rrsync pull keys (T0030). Ops replicates the SAME shape -- mount /:/host/root:ro, keep
// `filesystem` -- because free disk space is wanted here too (this host holds 5 GB+ of mirrors and
// will hold the overlay writer). Ops DOES hold a live private key today: `sync_nas_archive`
// (deploy:deploy, 0600, under /home/deploy/.ssh), the NAS-pull channel's key, pre-dating this task
// -- so running Alloy as `deploy` would let the /host/root mount read it directly, no escalation
// needed at all, defeating the protection this comment claims to replicate. (The
// RECONCILED_SOURCE channel is not an ops-side private key at all: its private half lives on the
// NAS; ops holds only a forced-command `authorized_keys` PUBLIC entry, which is not secret
// material.) Alloy here instead runs as the dedicated `zcrypto-alloy` system user (nologin,
// created by the role, uid/gid looked up via `getent` -- alloy-compose.yaml.j2's `user:`), which
// owns nothing under /home/deploy/.ssh -- this MIRRORS the NAS's uid-1031 choice, not merely
// resembles it. `group_add` grants Docker-socket access via the host's real numeric docker gid
// (derived at converge time via `getent`, alloy-compose.yaml.j2/tasks/main.yml), NOT a named
// "docker" entry -- Docker resolves a NAMED group_add entry against the CONTAINER's own
// /etc/group, not the host's, and the upstream grafana/alloy image ships only `alloy:x:473:`, so a
// literal "docker" would never resolve and the container would fail to start; the numeric gid is
// exactly why the NAS passes `group_add: ["0"]` rather than a name. Either way this is DEFENCE IN
// DEPTH ONLY: membership in the `docker` group is root-equivalent by definition (holding the
// Docker API lets you create a privileged container regardless of a `:ro` socket mount), so the
// escalation path remains -- exactly the residual the NAS's comments record for T0042. The point of
// the dedicated uid is narrower and real: it closes the DIRECT, no-escalation read of
// `sync_nas_archive` through the /host/root mount.
prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "loadavg", "meminfo", "filesystem", "netdev", "textfile"]

  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"

  textfile {
    // The four timers' textfiles (archive-pull, panel-materialize, verify-replay,
    // verified-replay), written since OPS-3/OPS-4 into ops_textfile_dir but scraped by nothing
    // until this task. alloy-compose.yaml.j2 mounts that host directory read-only at this exact
    // container path -- literal "/textfile", exactly like the NAS's, not a templated
    // ops_textfile_dir -- because this string names the CONTAINER's view of the mount, not the
    // host path.
    directory = "/textfile"
  }
}

// ---- Container metrics: intentionally NOT collected on ops, either -------------------------
// DIVERGENCE 1 (cadvisor): the NAS omits cadvisor because it SIGSEGVs on Synology DSM's
// cgroup-less kernel, taking down all of Alloy -- that rationale does NOT apply here: the ops node
// is Debian with a normal cgroup hierarchy, so cadvisor would simply work. It is still left out,
// omitted BY CHOICE here, not by DSM constraint: this task's job is the four textfile series +
// host metrics reaching Grafana (spec D1), container CPU/mem is not part of that gate, and adding
// cadvisor's series would eat into the active-series budget the spec flags as an open risk. A
// future task can add it deliberately if a container-level gate ever needs it.

// ---- Scrape -> remote_write ------------------------------------------------------------------
prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.remote_write.grafana.receiver]
  scrape_interval = "60s"
}

prometheus.remote_write "grafana" {
  // `host="ops"` on every metric this component ships -- without it, no metric on this host
  // carries a `host` label at all (the `host` label the logs pipeline attaches below, in
  // discovery.relabel "container_logs", is Loki-only and never reaches Prometheus), so
  // `infra/grafana/alerts.yaml`'s "Ops · node load high" rule
  // (`node_load1{host="ops"}`) selects nothing and can never fire. `external_labels` is applied
  // component-wide, before the write_relabel_config blocks below run -- so it does not touch the
  // drop/keep pair (both match on `__name__` only) and does not change the number of relabel
  // blocks.
  //
  // The NAS's config.alloy deliberately does NOT get the mirror-image `host="nas"` label, even
  // though that would look more symmetric: adding a label to an EXISTING, already-live series
  // changes that series' identity in Prometheus (the old series ends, a new one begins), and the
  // NAS ships `zcrypto_reconcile_residual_gap_seconds_total`, which
  // `infra/grafana/alerts.yaml`'s "Reconciler · residual gap increased (permanent loss)" rule
  // watches through `increase(...[1h]) > 0 and resets(...[1h]) == 0`. A series-identity change
  // underneath `increase()` can read as a value jump with no corresponding `resets()`, i.e. a
  // FALSE permanent-data-loss page -- not worth it for a symmetry nobody needs today.
  //
  // This is also useful, not merely tolerable: once the overlay writer moves to ops, ops's copy of
  // zcrypto_reconcile_* carries `host="ops"` while the NAS's carries no host label at all, making
  // the two hosts' series distinguishable -- exactly what a later task needs to prove the NAS's
  // stale copy is gone. Deliberate asymmetry, not an oversight.
  external_labels = {
    host = "ops",
  }

  endpoint {
    url = sys.env("GRAFANA_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_PROM_USERNAME")
      password = sys.env("GRAFANA_PROM_PASSWORD")
    }

    // Series minimization (00043): drop Alloy's own self-metrics first (defense in depth --
    // nothing scraped above is Alloy's own /metrics endpoint, so this is normally a no-op), then
    // keep-only the host + textfile series this stack actually wants. T0051 (spec 00054): a `keep`
    // action drops everything it does not list, so a series missing here does not merely go
    // undashboarded -- it does not exist. The last two families
    // (zcrypto_reconcile_.*/zcrypto_trade_backfill_.*) do not exist on this host yet -- they arrive
    // with Task 6's writer move -- but are listed NOW so that move does not also require reopening
    // this file. tests/test_infra_alloy_series.py pins this list against every series the stack
    // (present + Task 6's future) actually publishes.
    write_relabel_config {
      source_labels = ["__name__"]
      regex         = "go_.*|process_.*|alloy_.*"
      action        = "drop"
    }

    write_relabel_config {
      source_labels = ["__name__"]
      regex         = "up|node_load1|node_load5|node_load15|node_memory_MemTotal_bytes|node_memory_MemAvailable_bytes|node_memory_MemFree_bytes|node_filesystem_avail_bytes|node_filesystem_size_bytes|node_filesystem_free_bytes|node_network_receive_bytes_total|node_network_transmit_bytes_total|node_cpu_seconds_total|node_textfile_scrape_error|node_scrape_collector_success|node_scrape_collector_duration_seconds|ops_archive_pull_.*|ops_panel_.*|ops_verify_replay_.*|ops_verified_replay_.*|zcrypto_reconcile_.*|zcrypto_trade_backfill_.*"
      action        = "keep"
    }
  }
}

// ---- Logs: every container on this host -----------------------------------------------------
// Discover and ship every container on this host, host-wide rather than per-compose-project, same
// rationale as the NAS: no keep/drop here, so a container this role adds later is not silently
// invisible to the logs dashboard.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "container_logs" {
  targets = discovery.docker.containers.targets

  // DIVERGENCE 3 (host label + container-name regex): the NAS strips a literal
  // `zcrypto-archive-` compose-project prefix because that is its one project's name. Ops runs
  // several independent compose projects (liquidations, archive-pull's timers, this Alloy stack
  // itself, ...) with different project names, so this regex does NOT assume any one prefix -- it
  // only strips the leading `/` Docker always prepends and a trailing `-<replica index>`, leaving
  // the container name (with its own project prefix, if any) as the `container` label.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*?)(?:-[0-9]+)?"
    target_label  = "container"
    replacement   = "$1"
    action        = "replace"
  }

  // `host="ops"`, not "nas" -- this is the ops node. Static for the same reason the NAS's is
  // static: one Alloy instance per host today.
  rule {
    target_label = "host"
    replacement  = "ops"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.container_logs.output
  forward_to = [loki.process.parse.receiver]
}

// Parse ONCE, here at ingest -- never at query time. Same two stages as the NAS's pipeline: our
// Python services' own timestamped log line, and Alloy's own logfmt output.
loki.process "parse" {
  forward_to = [loki.write.grafana.receiver]

  // Our Python services: `2026-07-14 13:18:27,562 INFO zcrypto.archive.command [command.py:75] - msg`
  // Scoped by container, so a container with a different format can never be mangled by this regex.
  stage.match {
    selector = "{container=\"archive-pull\"}"

    stage.regex {
      expression = "^(?P<ts>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2},\\d{3}) (?P<level>[A-Z]+) (?P<rest>.*)$"
    }

    stage.timestamp {
      source   = "ts"
      format   = "2006-01-02 15:04:05,000"
      location = "UTC"
    }

    stage.template {
      source   = "level"
      template = "{{ ToUpper .Value }}"
    }

    stage.labels {
      values = { level = "level" }
    }

    stage.output {
      source = "rest"
    }
  }

  // Alloy's own logs are logfmt: `ts=<t> level=<lvl> msg="<text>" k=v k=v ...`.
  stage.match {
    selector = "{container=\"alloy\"} |~ \"^ts=\\\\S+ level=\\\\S+ msg=\""

    stage.regex {
      expression = "^ts=\\S+ level=(?P<level>\\w+) msg=(?:\"(?P<msg>(?:[^\"\\\\]|\\\\.)*)\"|(?P<msg_bare>\\S+))\\s*(?P<rest>.*)$"
    }

    stage.template {
      source   = "level"
      template = "{{ if eq .Value \"warn\" }}WARNING{{ else if eq .Value \"fatal\" }}CRITICAL{{ else }}{{ ToUpper .Value }}{{ end }}"
    }

    stage.labels {
      values = { level = "level" }
    }

    stage.template {
      source   = "line"
      template = "{{ if .msg }}{{ .msg }}{{ if .rest }} {{ .rest }}{{ end }}{{ else if .msg_bare }}{{ .msg_bare }}{{ if .rest }} {{ .rest }}{{ end }}{{ else }}{{ .Entry }}{{ end }}"
    }

    stage.output {
      source = "line"
    }
  }
}

loki.write "grafana" {
  endpoint {
    url = sys.env("GRAFANA_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_LOKI_USERNAME")
      password = sys.env("GRAFANA_LOKI_PASSWORD")
    }
  }
}
