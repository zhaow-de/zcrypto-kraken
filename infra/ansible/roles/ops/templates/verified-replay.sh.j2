#!/usr/bin/env bash
# Rendered by the `ops` Ansible role at /usr/local/sbin/zcrypto-verified-replay — do not hand-edit
# on the host, edit infra/ansible/roles/ops/templates/verified-replay.sh.j2 and re-converge instead.
#
# Daily verified-path replay of the pulled engine journal (spec 00051 OPS-3): runs
# `zcrypto engine replay --path verified` (the oracle builder) in the digest-pinned default-AVX
# image, publishes the outcome as a node-exporter textfile (ops_verified_replay_*; a non-zero
# exit_code is the CLI's own mismatch/validation-failure verdict), and pings the dead-man URL on a
# clean run only — an empty URL skips the ping (the CLI's optional `ping_healthcheck` semantics,
# shell edition).
set -u

PROM="{{ ops_textfile_dir }}/ops-verified-replay.prom"
URL="{{ ops_verified_replay_healthcheck_url }}"

# D9 (spec 00054): scope the replay to ONE day instead of the whole journal. Unscoped, this cost
# grows with the archive forever -- the ops node's speed would merely hide that, which is exactly
# why it is bounded now rather than when it next hurts. YESTERDAY, not today: at 05:23 UTC today's
# journal holds at most the 00:00/04:00 cycles, so scoping to today would replay an incomplete day
# and call it verified. Yesterday is complete and immutable, so the verdict is final.
REPLAY_DATE=$(date -u -d yesterday +%F)

# T0060: a stable `--name` -- an unnamed `docker run --rm` got a fresh engine-random name each run,
# and each name minted a brand-new Loki stream, forever, on a backend that bills per stream. The
# name also makes this job selectable by Alloy's parse stage (config.alloy's `zcrypto-.*` selector).
# A leftover container after a dockerd crash makes the NEXT run fail loudly on a name conflict
# (unit rc!=0 -> the exit-code alert) -- acceptable and self-describing; `--rm` cleans up in every
# normal path.
docker run --rm --pull never \
    --name zcrypto-verified-replay \
    --user "{{ ops_uid }}:{{ ops_gid }}" \
    -v "{{ ops_data_dir }}:/data:ro" \
    --entrypoint zcrypto \
    "{{ ops_image }}@{{ ops_image_digest }}" \
    engine replay --path verified --date "$REPLAY_DATE" --journal-dir "/data/{{ ops_journal_subdir }}"
rc=$?

now=$(date -u +%s)
# A failed run must not erase "when did this last succeed" — carry the previous value forward, so
# "time since last clean replay" stays directly alertable (same reason the reconcile exporter
# freezes last_success on a failed cycle).
prev_success=$(awk '/^ops_verified_replay_last_success_timestamp/ {print $2}' "$PROM" 2>/dev/null)
if [ "$rc" -eq 0 ]; then
    success=$now
else
    success="${prev_success:-0}"
fi

# Atomic publish (tmp in the same dir, then rename): a textfile is scraped in place, so a
# half-written one is scraped as garbage — same pattern as the reconcile exporter's _write_textfile.
tmp="$PROM.tmp"
{
    printf '# HELP ops_verified_replay_exit_code Exit code of the last verified-path journal replay (0 = no mismatch, no validation failure).\n'
    printf '# TYPE ops_verified_replay_exit_code gauge\n'
    printf 'ops_verified_replay_exit_code %s\n' "$rc"
    printf '# HELP ops_verified_replay_last_run_timestamp Unix time of the last run, clean or not.\n'
    printf '# TYPE ops_verified_replay_last_run_timestamp gauge\n'
    printf 'ops_verified_replay_last_run_timestamp %s\n' "$now"
    printf '# HELP ops_verified_replay_last_success_timestamp Unix time of the last clean run (0 = never).\n'
    printf '# TYPE ops_verified_replay_last_success_timestamp gauge\n'
    printf 'ops_verified_replay_last_success_timestamp %s\n' "$success"
} > "$tmp"
mv "$tmp" "$PROM"

if [ "$rc" -eq 0 ] && [ -n "$URL" ]; then
    curl -fsS -m 10 -o /dev/null "$URL" || true
fi
exit "$rc"
