# Rendered by the `ops` Ansible role at /etc/systemd/system/zcrypto-grafana-watchdog.service — do
# not hand-edit on the host, edit infra/ansible/roles/ops/templates/grafana-watchdog.service.j2
# instead.
# Traceability: T0083
[Unit]
Description=Availability probe of the Grafana that pages and the dead-man service, gating the zcrypto-grafana-watchdog dead-man
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Sourced rather than interpolated into the runner script. `-` so a unit started before the file exists
# still probes and pings.
EnvironmentFile=-{{ ops_compose_dir }}/grafana-watchdog-secrets.env
StateDirectory=zcrypto-grafana-watchdog
ExecStart=/usr/local/sbin/zcrypto-grafana-watchdog
