#!/usr/bin/env bash
# Rendered by the `ops` Ansible role at /usr/local/sbin/zcrypto-panel-regenerate — do not
# hand-edit on the host; edit infra/ansible/roles/ops/templates/panel-regenerate.sh.j2 and
# re-converge instead. Traceability: spec 00083 D2.
#
# Delete-and-rebuild of the L2 panel tree as one refusing flow: timer stopped first, window sized
# from the input tree (~2.1 s/MB, x1.2 margin) against the 02:25 UTC auto-reboot, the dead-man
# pause taken as a TYPED gate (the point of no return stays human), delete, rebuild INSIDE the
# materialize unit (a stray timer tick collides with an active unit instead of double-writing),
# then the operator checklist for the halves this host cannot reach (NAS copy, un-pause).
# rc 2 usage/bad override | rc 3 refused, timer restarted, nothing deleted | rc 4 rebuild failed.
set -euo pipefail

PANEL_ROOT="{{ ops_data_dir }}/{{ ops_panel_subdir }}"
CANONICAL="{{ ops_nas_mount }}/{{ ops_capture_subdir }}"
OVERLAY="{{ ops_data_dir }}/{{ ops_reconciled_subdir }}"

# Render guard, before anything is touched: this script's payload is `rm -rf "$PANEL_ROOT"`, and
# PANEL_ROOT is TWO rendered halves -- either one empty aims it somewhere it must never point. An
# empty ops_panel_subdir makes it the ops data root itself (the reconciled overlay, the liquidations
# tree and the textfile dir would go with the panel); an empty ops_data_dir makes it "/<subdir>", a
# path at the filesystem root, outside anything this host's data layout owns. `set -u` cannot catch
# either (each var IS set, to a string with an empty component) and Ansible refuses only UNDEFINED
# vars, not empty ones, so the check belongs here.
if [ -z "{{ ops_data_dir }}" ] || [ -z "{{ ops_panel_subdir }}" ]; then
  echo "refusing: the panel root rendered from an empty half ('{{ ops_data_dir }}' + '{{ ops_panel_subdir }}'), which would aim rm -rf at the whole data root or the filesystem root" >&2
  exit 2
fi

override=""
if [ "$#" -gt 0 ]; then
  if [ "$1" = "--override" ] && [ "$#" -eq 2 ]; then
    override="$2"
  else
    echo 'usage: zcrypto-panel-regenerate [--override "<reason>"]' >&2
    exit 2
  fi
fi
if [ -n "$override" ]; then
  low=$(printf '%s' "$override" | tr '[:upper:]' '[:lower:]')
  # Offset expansion, NOT the length form: bash's string-length expansion opens with a brace-hash
  # pair, which Jinja reads as a comment tag, so the template would not render at all. A raw block
  # around it does not save this either — Ansible renders with trim_blocks, which eats the newline
  # after the closing tag and welds the next line onto it. This form is inert to Jinja entirely:
  # "${override:8}" is empty exactly when the reason is 8 characters or shorter.
  if [ -z "${override:8}" ] || [ "$low" = "true" ] || [ "$low" = "false" ] || [ "$low" = "1" ] || [ "$low" = "yes" ]; then
    echo "refusing: --override needs a reason (more than 8 chars, not a boolean)" >&2
    exit 2
  fi
fi

echo "== step 1: stopping the hourly timer =="
systemctl stop zcrypto-panel-materialize.timer
echo "timer stopped. Reminder: a converge re-arms it unless -e ops_panel_timer_hold=true is passed."

# Stopping the TIMER does not stop a run already under way, and step 4's `rm -rf` beneath a live
# materialize half-deletes a tree that process believes it owns. Read the STATE STRING, never
# `is-active --quiet`'s exit code: this unit is Type=oneshot, so an hourly run in flight sits in
# `activating` for its entire runtime, and is-active exits 0 only for active/reloading -- the
# exit-code form walks straight past exactly the case this refuses.
unit_state=$(systemctl is-active zcrypto-panel-materialize.service || true)
case "$unit_state" in
  active | activating | reloading)
    echo "refusing: an hourly materialize run is in flight (state: $unit_state); re-run once it completes. Timer restarted, nothing deleted." >&2
    systemctl start zcrypto-panel-materialize.timer
    exit 3
    ;;
esac

echo "== step 2: sizing the rebuild =="
# One assignment per input, never both inside one arithmetic expansion: there the assignment takes
# only the LAST substitution's status and an empty operand parses as unary plus, so a failing du on
# the NFS-side canonical tree is swallowed and the ETA is sized from the overlay alone -- the
# central refusal neutralized exactly when the NAS mount is what is broken (measured). Split, either
# failure is its own statement and `set -e` + `pipefail` abort here, with the timer left stopped:
# the hourly materialize must not resume against a tree this host cannot stat, and the dead-man
# check is still armed at this point, so the missed ping pages.
canon_mb=$(du -sm "$CANONICAL" | cut -f1)
overlay_mb=$(du -sm "$OVERLAY" | cut -f1)
mb=$(( canon_mb + overlay_mb ))
eta=$(awk -v m="$mb" 'BEGIN{printf "%d", m * 2.1 * 1.2}')
now=$(date -u +%s)
deadline=$(date -u -d "$(date -u +%F) 02:25" +%s)
[ "$now" -ge "$deadline" ] && deadline=$(( deadline + 86400 ))
echo "input ${mb} MB -> ETA ~$(( eta / 60 )) min incl. margin; auto-reboot deadline epoch $deadline"
if [ $(( now + eta )) -ge "$deadline" ]; then
  if [ -n "$override" ]; then
    echo "override accepted: $override"
  else
    echo "refusing: the rebuild would still be running at the 02:25 UTC auto-reboot (a oneshot unit has no timeout — only that reboot kills it). Re-run earlier in the day, or pass --override \"<reason>\"." >&2
    systemctl start zcrypto-panel-materialize.timer
    echo "timer restarted (nothing was deleted)."
    exit 3
  fi
fi

if ! { : < /dev/tty; } 2>/dev/null; then
  echo "no controlling terminal — the pause gate needs an attended session; timer restarted, nothing deleted" >&2
  systemctl start zcrypto-panel-materialize.timer
  exit 3
fi
echo "== step 3: pause the dead-man check =="
echo "The panel healthcheck pings only on a clean run and is this timer's only liveness signal."
echo "Pause it now, TIME-BOXED, on healthchecks.io (the panel materialize check)."
printf 'Type "paused" to continue (anything else aborts, nothing deleted): ' > /dev/tty
IFS= read -r reply < /dev/tty || reply=""
if [ "$reply" != "paused" ]; then
  systemctl start zcrypto-panel-materialize.timer
  echo "aborted — nothing deleted; timer restarted." >&2
  exit 3
fi

echo "== step 4: deleting the ops-side panel tree =="
rm -rf "$PANEL_ROOT"
echo "deleted $PANEL_ROOT (the per-pair watermarks went with it — the rebuild covers everything, out-of-scope subtrees included)"

echo "== step 5: rebuilding inside the unit =="
# Anchor the journal read that follows to THIS run. `systemctl start --wait` returning does not
# prove journald has committed the unit's last lines, and an unanchored `tail -1` would then hand
# back the PREVIOUS run's numbers -- the same wrong-run failure the capture exists to prevent.
rebuild_since=$(date -u +%s)
if ! systemctl start --wait zcrypto-panel-materialize.service; then
  echo "rebuild FAILED (the unit reported non-zero). The tree is now partial — investigate before anything else. The timer stays STOPPED and the closing checklist is NOT owed yet." >&2
  exit 4
fi
echo "rebuild complete."

# BEFORE the timer restart, deliberately. The runner's completion line carries hours_unanchored --
# the counter the checklist below branches on, and the only thing that later separates a stale orphan
# on the NAS from the last surviving copy of an hour this rebuild could not reproduce. It carries
# hours_unsettled beside it, which matters only if the settle window ever widens between generations;
# record both, decide on the first. They are unrecoverable from the tree,
# and the one written-from-memory record of that line lost exactly those two fields. `tail -1` is
# only trustworthy while the rebuild IS the newest run: the timer is Persistent=true, so restarting
# it can fire a queued catch-up tick immediately, and the T0111 drill recorded that tick reporting
# hours_written=80 hours_skipped=6370 -- plausible, reassuring, and the wrong run.
echo "== the rebuild's own completion line — record it whole, both unanchored counts included =="
# Captured into a variable, not piped straight to the terminal: with `pipefail` a journalctl that
# emits its lines and THEN exits non-zero makes the pipeline fail after the text is already out, so
# a trailing `|| echo` would print the line and the could-not-read message together. One read, one
# verdict, one message. `-o short-iso` keeps the timestamp so the operator can see which run it is.
completion=$(journalctl -u zcrypto-panel-materialize.service --since "@$rebuild_since" --no-pager -o short-iso 2>/dev/null \
  | grep -F 'hours_written' | tail -1 || true)
if [ -n "$completion" ]; then
  echo "  $completion"
else
  echo "  (could not read it back — recover with: journalctl -u zcrypto-panel-materialize.service --since \"@$rebuild_since\" | grep hours_written)"
fi

systemctl start zcrypto-panel-materialize.timer
echo "timer restarted."

echo "== step 6: your remaining checklist =="
echo "1. Un-pause the healthchecks.io panel check (paused time-boxed in step 3). Do this FIRST: it is"
echo "   the materialize timer's only liveness signal, and every run until you do is unwatched."
echo "2. The NAS copy of {{ ops_panel_subdir }}. A deletion is owed ONLY when this rebuild wrote to"
echo "   DIFFERENT paths than the old tree. Exactly two things do that, and a schema bump is NOT one:"
echo "     - the grid directory name changed (the path carries it as a literal); or"
echo "     - a pair left the archive, or left the panel's quote scope — that orphans a whole subtree"
echo "       with no generation change at all, which is the case nothing else catches."
echo "   A schema, notional-ladder or level-count change FORCES a regeneration but rewrites identical"
echo "   paths, so it orphans nothing. The pull is rsync without --delete, so only paths the rebuild"
echo "   no longer writes survive there. Measure before deleting — from this host, which sees both:"
echo "     find \"$PANEL_ROOT\" -type f -printf '%P\\n' | LC_ALL=C sort > /tmp/ops-panel.txt"
echo "     find {{ ops_nas_mount }}/{{ ops_panel_subdir }} -type f -printf '%P\\n' | LC_ALL=C sort > /tmp/nas-panel.txt"
echo "     wc -l /tmp/ops-panel.txt /tmp/nas-panel.txt   # both non-zero, or the check proved nothing"
echo "     LC_ALL=C comm -13 /tmp/ops-panel.txt /tmp/nas-panel.txt   # NAS-only: the delete CANDIDATES"
echo "   comm needs LC_ALL=C as much as the sorts do: under a UTF-8 locale it rejects C-sorted input"
echo "   as unsorted and exits 1, right at the moment you are deciding whether to delete."
echo "   Empty output means nothing is owed. Record that it was measured, and stop."
echo "   Non-empty is NOT a licence to delete. The materialize sweep skips every hour at or below its"
echo "   watermark, so an hour this rebuild failed to anchor is missing here and present ONLY on the"
echo "   NAS — indistinguishable, by path alone, from a stale orphan. Deleting such an hour destroys"
echo "   its last copy, and the pull runs outward from this host, so nothing brings it back."
echo "   If hours_unanchored above is 0, every candidate is a real orphan and may be deleted."
echo "   If it is NOT 0, the count alone will not tell you WHICH hours — that comes from the same"
echo "   journal, one WARNING per contiguous bad run per pair:"
echo "     journalctl -u zcrypto-panel-materialize.service --since \"@$rebuild_since\" | grep unanchored"
echo "   Those name the START of each bad run, not every hour in it, so they are a lead and not a map."
echo "   Unless you can account for EVERY candidate against them, delete nothing — and if the counts"
echo "   could not be read at all, delete nothing regardless: an unread count is not a zero."
echo "   Delete on the NAS itself. {{ ops_nas_mount }} is mounted READ-ONLY here and must never be"
echo "   written through. On the NAS the tree is /volume1/ZhaoCrypto/l2-panel — written as a literal"
echo "   on purpose: that target is pinned NAS-side and only happens to match this host's name for"
echo "   the same tree, so confirm it there rather than assuming the two names move together."
