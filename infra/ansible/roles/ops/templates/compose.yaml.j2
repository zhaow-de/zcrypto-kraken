# Rendered by the `ops` Ansible role at {{ ops_compose_dir }}/compose.yaml — do not hand-edit on
# the host, it is overwritten on the next converge. Edit
# infra/ansible/roles/ops/templates/compose.yaml.j2 instead.
services:
  liquidations:
    # The capture image (default AVX build) — the exec-form entrypoint override cleanly bypasses
    # capture's shell ENTRYPOINT and starts the Coinalyze liquidation poller instead (one image,
    # many services; same pattern as the engine compose). No trade key, no engine (spec 00051 D10).
    #
    # T0023: Binance geo-fences its futures WS from every egress we own, so the `zcrypto
    # liquidations` WS recorder (shelved in place, not deleted) is replaced here by `zcrypto
    # liquidations-poll` — same output tree, so the NAS replication channel + dead-man are unchanged.
    image: "{{ ops_image }}@{{ ops_image_digest }}"
    container_name: zcrypto-ops-liquidations
    restart: unless-stopped
    user: "{{ ops_uid }}:{{ ops_gid }}"
{% if logship_loki_token is defined %}
    # --ship-logs is spelled out here, not left to the image's own shell-ENTRYPOINT conveyance
    # (Dockerfile's `${ZCRYPTO_SHIP_LOGS:+--ship-logs}`, spec 00068 D3/T4): this service's
    # exec-form `entrypoint:` REPLACES the image's ENTRYPOINT wholesale, so that shell expansion
    # never runs here -- the flag must be baked in at render time instead.
    entrypoint: ["zcrypto", "--ship-logs", "liquidations-poll"]
{% else %}
    entrypoint: ["zcrypto", "liquidations-poll"]
{% endif %}
    environment:
      ZCRYPTO_LIQUIDATIONS_DATA_DIR: /data/liquidations
      LIQUIDATIONS_HEALTHCHECK_URL: "{{ ops_liquidations_healthcheck_url }}"
      COINALYZE_API_KEY: "{{ coinalyze_api_key }}"
      # Spec 00069 D6: UNGUARDED, unlike the logship additions below -- no embargo flag, because
      # env+port without the new image are inert (unknown env var, unpublished port) and the new
      # image without this env is exporter-off. Port 9103 is scraped by the `liquidations_app`
      # job in this role's own files/config.alloy -- change both together.
      ZCRYPTO_METRICS_PORT: "9103"
{% if logship_loki_token is defined %}
      ZCRYPTO_LOG_HOST: ops
      ZCRYPTO_LOG_SERVICE: liquidations
{% endif %}
    # `127.0.0.1:9103:9103` (spec 00069 D3): the security boundary is this HOST-side publish, not
    # an in-container bind -- the exporter binds 0.0.0.0 inside the container (bridge-networked;
    # Docker delivers published-port traffic to eth0, never loopback), so loopback-only here is
    # what keeps `/metrics` off the internet. nftables untouched.
    ports:
      - "127.0.0.1:9103:9103"
    volumes:
      - "{{ ops_data_dir }}:/data"
{% if logship_loki_token is defined %}
    # The zcrypto CLI's own Loki push creds, rendered by tasks/main.yml alongside this compose
    # file (spec 00068 D5/T6) -- NOT gated on `ops_image_digest`: see that render task's own
    # comment. `required: false` (long form) keeps `docker compose up` from refusing to start
    # outright if the file is ever absent at start time (a converge landing before the vault
    # carried the token, or the file deleted out-of-band between converges) -- mirroring the
    # capture role's hardening (00068 T4/T5 review Minor-1). Guarded by the SAME
    # `logship_loki_token is defined` condition as the entrypoint/environment additions above.
    env_file:
      - path: "{{ ops_compose_dir }}/logship-secrets.env"
        required: false
{% endif %}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
