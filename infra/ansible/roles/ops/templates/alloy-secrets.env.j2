# Grafana Cloud's and the node's ingest credentials for the ops node's Alloy container (spec 00054
# D1/D7, spec 00121 D13), rendered by the `ops` role from group_vars/observed/ -- vault.yml for the
# secrets, vars.yml for the node's two URLs and its user -- do not hand-edit on the host, it is
# overwritten on the next converge.
# Names must match config.alloy's `sys.env(...)` calls exactly -- tests/test_infra_alloy_series.py
# holds the GRAFANA_* and MON_* lines by literal and the rendered names to the config's reads.
GRAFANA_PROM_URL={{ grafana_prom_url }}
GRAFANA_PROM_USERNAME={{ grafana_prom_user }}
GRAFANA_PROM_PASSWORD={{ grafana_prom_token }}
GRAFANA_LOKI_URL={{ grafana_loki_url }}
GRAFANA_LOKI_USERNAME={{ grafana_loki_user }}
GRAFANA_LOKI_PASSWORD={{ grafana_loki_token }}
{# T0083: ops alone scrapes healthchecks.io: the hc.io Prometheus endpoint path with the embedded
   read-only key, consumed by config.alloy's prometheus.scrape "healthchecks". #}
HC_METRICS_PATH={{ hc_prometheus_metrics_path }}
MON_PROM_URL={{ mon_ingest_prom_url }}
MON_PROM_USERNAME={{ mon_ingest_fleet_user }}
MON_PROM_PASSWORD={{ mon_ingest_fleet_password }}
MON_LOKI_URL={{ mon_ingest_loki_url }}
MON_LOKI_USERNAME={{ mon_ingest_fleet_user }}
MON_LOKI_PASSWORD={{ mon_ingest_fleet_password }}
