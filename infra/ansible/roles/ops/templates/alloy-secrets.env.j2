# The node's ingest credentials for the ops node's Alloy container (spec 00054
# D1/D7, spec 00121 D13), rendered by the `ops` role from group_vars/observed/ -- vault.yml for the
# secrets, vars.yml for the node's two URLs, its user and the dead-man scrape's path -- do not
# hand-edit on the host, it is overwritten on the next converge.
# Names must match config.alloy's `sys.env(...)` calls exactly -- tests/test_infra_alloy_series.py
# holds the MON_* and HC_* lines by literal and the rendered names to the config's reads.
{# T0083, spec 00122 D7: ops alone scrapes the dead-man service, config.alloy's prometheus.scrape
   "healthchecks"; no other role renders hc_readonly_api_key (infra/scripts/count-list.sh hc-readonly-key-in-a-role). #}
HC_METRICS_PATH={{ hc_metrics_path }}
HC_READONLY_KEY={{ hc_readonly_api_key }}
MON_PROM_URL={{ mon_ingest_prom_url }}
MON_PROM_USERNAME={{ mon_ingest_fleet_user }}
MON_PROM_PASSWORD={{ mon_ingest_fleet_password }}
MON_LOKI_URL={{ mon_ingest_loki_url }}
MON_LOKI_USERNAME={{ mon_ingest_fleet_user }}
MON_LOKI_PASSWORD={{ mon_ingest_fleet_password }}
