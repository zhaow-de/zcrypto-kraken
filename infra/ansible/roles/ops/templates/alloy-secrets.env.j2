# Grafana Cloud credentials for the ops node's Alloy container (spec 00054 D1/D7), rendered by the
# `ops` role from group_vars/observed/vault.yml -- do not hand-edit on the host, it is overwritten
# on the next converge. The NAS's alloy-secrets.env is rendered the SAME way by the `nas` role
# since T0056 (same six names, straight from group_vars/observed/vault.yml) -- no hand-placed
# out-of-band copy exists anywhere anymore.
# Names must match config.alloy's `sys.env(...)` calls exactly -- tests/test_infra_alloy_series.py
# does not check this file, so a rename here silently breaks remote_write/loki.write with no test
# failure to catch it.
GRAFANA_PROM_URL={{ grafana_prom_url }}
GRAFANA_PROM_USERNAME={{ grafana_prom_user }}
GRAFANA_PROM_PASSWORD={{ grafana_prom_token }}
GRAFANA_LOKI_URL={{ grafana_loki_url }}
GRAFANA_LOKI_USERNAME={{ grafana_loki_user }}
GRAFANA_LOKI_PASSWORD={{ grafana_loki_token }}
