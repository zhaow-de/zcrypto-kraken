#!/usr/bin/env bash
# Rendered by the `ops` Ansible role at /usr/local/sbin/zcrypto-verify-replay — do not hand-edit on
# the host, edit infra/ansible/roles/ops/templates/verify-replay.sh.j2 and re-converge instead.
#
# Daily continuity-replay of the canonical archive (spec 00051 OPS-3): runs
# `zcrypto archive verify-replay` in the digest-pinned default-AVX image, reading the primary tree
# straight from the NAS's read-only NFS export at /nas (T0058 — the local capture mirror is
# retired) with the ops-written reconciled overlay still local at /data, publishes the outcome as a
# node-exporter textfile (ops_verify_replay_*), and pings the dead-man URL on a clean run only — an
# empty URL skips the ping (the CLI's optional `ping_healthcheck` semantics, shell edition).
# The mount is ro,soft: a hung NAS surfaces EIO, which the CLI treats as a loud integrity fact
# (rc!=0 -> the exit-code alert), never as absence.
set -u

PROM="{{ ops_textfile_dir }}/ops-verify-replay.prom"
URL="{{ ops_verify_replay_healthcheck_url }}"

# spec 00076 D7: the replay is WINDOWED. Unwindowed, a single historical bad hour exits 1 every
# day forever behind the CRITICAL exit-code alert -- training an operator to ignore the one alert
# that means the archive stopped replaying. The window is computed per run, never rendered at
# converge time (a baked date freezes on the day of the converge and narrows to nothing). Old hours
# are not left unguarded: the hourly archive-pull hash-verifies every segment against its manifest.
SINCE=$(date -u -d '{{ ops_verify_replay_window_days }} days ago' +%F)

# T0060: a stable `--name` -- an unnamed `docker run --rm` got a fresh engine-random name each run,
# and each name minted a brand-new Loki stream, forever, on a backend that bills per stream. That
# log-shipping rationale is gone now (00068 D6/D8): there is no docker path left to drop anything
# by name -- discovery.docker retired fleet-wide -- so this run's stdout ships via the unit's own
# journal stream regardless of its name (attached, not -d). What the stable name still buys, and
# the only reason it stays: a leftover container after a dockerd crash makes the NEXT run fail
# loudly on a name conflict (unit rc!=0 -> the exit-code alert) -- acceptable and self-describing;
# `--rm` cleans up in every normal path.
docker run --rm --pull never \
    --name zcrypto-verify-replay \
    --user "{{ ops_uid }}:{{ ops_gid }}" \
    -v "{{ ops_nas_mount }}:/nas:ro" \
    -v "{{ ops_data_dir }}:/data:ro" \
    --entrypoint zcrypto \
    "{{ ops_image }}@{{ ops_image_digest }}" \
    archive verify-replay "/nas/{{ ops_capture_subdir }}" "/data/{{ ops_reconciled_subdir }}" --since "$SINCE"
rc=$?

now=$(date -u +%s)
# A failed run must not erase "when did this last succeed" — carry the previous value forward, so
# "time since last clean replay" stays directly alertable (same reason the reconcile exporter
# freezes last_success on a failed cycle).
prev_success=$(awk '/^ops_verify_replay_last_success_timestamp/ {print $2}' "$PROM" 2>/dev/null)
if [ "$rc" -eq 0 ]; then
    success=$now
else
    success="${prev_success:-0}"
fi

# Atomic publish (tmp in the same dir, then rename): a textfile is scraped in place, so a
# half-written one is scraped as garbage — same pattern as the reconcile exporter's _write_textfile.
tmp="$PROM.tmp"
{
    printf '# HELP ops_verify_replay_exit_code Exit code of the last canonical continuity-replay (0 = every hour coherent).\n'
    printf '# TYPE ops_verify_replay_exit_code gauge\n'
    printf 'ops_verify_replay_exit_code %s\n' "$rc"
    printf '# HELP ops_verify_replay_last_run_timestamp Unix time of the last run, clean or not.\n'
    printf '# TYPE ops_verify_replay_last_run_timestamp gauge\n'
    printf 'ops_verify_replay_last_run_timestamp %s\n' "$now"
    printf '# HELP ops_verify_replay_last_success_timestamp Unix time of the last clean run (0 = never).\n'
    printf '# TYPE ops_verify_replay_last_success_timestamp gauge\n'
    printf 'ops_verify_replay_last_success_timestamp %s\n' "$success"
} > "$tmp"
mv "$tmp" "$PROM"

if [ "$rc" -eq 0 ] && [ -n "$URL" ]; then
    curl -fsS -m 10 -o /dev/null "$URL" || true
fi
exit "$rc"
