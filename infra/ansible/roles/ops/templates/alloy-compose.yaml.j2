# Grafana Alloy compose file for the ops node's telemetry stack (spec 00054 D1/D7). Rendered by
# the `ops` Ansible role at {{ ops_alloy_dir }}/compose.yaml -- do not hand-edit on the host, it is
# overwritten on the next converge. Edit
# infra/ansible/roles/ops/templates/alloy-compose.yaml.j2 instead.
#
# Its OWN compose project (this file, not infra/ansible/roles/ops/templates/compose.yaml.j2's
# liquidations project): an Alloy redeploy (image bump, config change) must never restart the
# liquidations poller, which is not backfillable (same isolation rationale as the NAS's separate
# archive-pull/alloy services, here taken one step further into separate compose projects since
# ops runs several independent services, not two in one file).
#
# Modeled on infra/nas/compose.yaml's `alloy` service; see config.alloy for the two
# deliberate divergences from the NAS's pipeline (cadvisor, user/rootfs). Deliberately NOT started
# here -- first start is an attended step (plan Task 3), same rationale as the liquidations poller
# in compose.yaml.j2: this task's job is to make the render correct, not to restart anything as a
# converge side effect.
services:
  alloy:
    # Pin this to a digest at deploy time (plan Task 3) -- ops_alloy_digest has NO default
    # (defaults/main.yml), so a converge without it skips this whole role block rather than
    # rendering a compose file pointing at a broken image reference.
    image: "{{ ops_alloy_image }}@{{ ops_alloy_digest }}"
    container_name: grafana-alloy
    restart: unless-stopped
    # DIVERGENCE 2: run as the dedicated `zcrypto-alloy` uid/gid (a non-login system user created by
    # the role, looked up via `getent` -- tasks/main.yml), NOT the `deploy` uid/gid that owns the
    # live `sync_nas_archive` private key under /home/deploy/.ssh. `deploy` would be readable
    # directly through the /host/root:ro mount below, with no escalation needed at all -- defeating
    # the protection this stack claims to replicate from the NAS (T0030, uid 1031 there). This
    # mirrors the NAS's dedicated-uid choice rather than merely resembling it (review finding 1).
    user: "{{ ops_alloy_uid }}:{{ ops_alloy_gid }}"
    group_add:
      # Journal files are root:systemd-journal 0640 and the container runs as the non-root
      # zcrypto-alloy user above, so reading the /host/journal mount below needs the host's
      # systemd-journal gid -- NUMERIC, derived at converge time via `getent` (tasks/main.yml),
      # never hardcoded (it is a per-host accident): Docker resolves a NAMED group_add entry
      # against the CONTAINER's own /etc/group, not the host's, and the upstream grafana/alloy
      # image ships only `alloy:x:473:` -- no `systemd-journal` entry -- so a literal name would
      # never resolve. This grants read of the WHOLE system journal, read-only -- broader than the
      # units the pipeline keeps, but strictly telemetry-class data. The docker-socket group_add
      # this used to sit alongside is gone: the socket mount below it retired with
      # `discovery.docker` (00068 D6), so this is Alloy's only remaining group grant.
      - "{{ ops_journal_gid }}"
    network_mode: host
    environment:
      # Go's GC otherwise overshoots a small `memory` cap under default behavior (00043).
      GOMEMLIMIT: 460MiB
    env_file:
      # Grafana Cloud remote_write + Loki creds (GRAFANA_PROM_URL/USERNAME/PASSWORD,
      # GRAFANA_LOKI_URL/USERNAME/PASSWORD) -- 0600, never committed, rendered by this role
      # (tasks/main.yml, from group_vars/observed/vault.yml) with no_log: true + diff: false so a
      # converge never prints the values, owned by the `zcrypto-alloy` user (Alloy's container
      # `user:` above) so it can read a 0600 file it does not own by default -- see
      # infra/ops/README.md.
      - ./alloy-secrets.env
    command:
      - run
      - --storage.path=/var/lib/alloy
      - --server.http.listen-addr=127.0.0.1:12345
      - /etc/alloy/config.alloy
    volumes:
      # Alternate-path RO mounts (mounting over Alloy's own container /proc//sys is impossible) --
      # config.alloy points procfs_path/sysfs_path/rootfs_path at these. Ops DOES hold a live
      # private key today (`sync_nas_archive`, deploy:deploy 0600, under /home/deploy/.ssh, the
      # NAS-pull channel, pre-dating this task) -- so this mount is exactly the T0030 residual the
      # NAS carries; the `user:` override above (zcrypto-alloy, not `deploy`) is what keeps it from
      # reading that key directly.
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/host/root:ro
      # The DIRECTORY, not the file: a single-file bind mount binds the inode, and Ansible's
      # atomic write replaces it, so the container would keep reading a file that no longer
      # exists in the host tree. Mounting the dir makes every later edit visible through the
      # path; the `reload alloy` handler is what makes Alloy parse it.
      - ./conf:/etc/alloy:ro
      # RW: the remote_write WAL + Loki log positions must survive container replacement, or a
      # redeploy re-ships the retained log backlog into the ingest quota (00043).
      - ./alloy-data:/var/lib/alloy
      # The four timers' textfiles (OPS-3/OPS-4), read-only -- Alloy only ever reads them.
      - "{{ ops_textfile_dir }}:/textfile:ro"
      # The host's persistent journal, for loki.source.journal (config.alloy): the four
      # zcrypto-*.service units' logs (including the orchestration scripts' host-side lines, which
      # exist in NO container log) AND Alloy's own journald-driver stream (00068 D6) -- there is no
      # docker-socket path left on this host to carry either. The `group_add` gid above is what
      # makes the 0640 root:systemd-journal files readable.
      - /var/log/journal:/host/journal:ro
      # Journal readers resolve the CURRENT boot's files via the host's machine id
      # (/var/log/journal/<machine-id>/...) -- without this mount the reader sees an empty journal.
      - /etc/machine-id:/etc/machine-id:ro
    deploy:
      resources:
        limits:
          memory: 512m
          # Unlike the NAS (no CPU cgroup on DSM), Debian has a real CPU cgroup, so a `cpus:` limit
          # actually holds here -- and it must: this box exists to run the overlay writer fast
          # (plan Task 6/7), and Alloy must never contend with it for CPU. 2.0 of the box's 24
          # threads is ample for a metrics/logs shipper.
          cpus: "2.0"
    # journald, not json-file (00068 D6): Alloy's own logs now reach Grafana Cloud through the
    # same journal + `loki.source.journal` pipeline (config.alloy) that already carries the four
    # zcrypto-*.service units' lines -- so its stdout has no json.log to rotate any more, and
    # rotation is the host journal's job instead.
    logging:
      driver: journald
