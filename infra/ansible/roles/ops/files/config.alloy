// Grafana Alloy config for the ops node's telemetry stack (spec 00054 D1/D7). Installed by the
// `ops` Ansible role via `ansible.builtin.copy` at ops_alloy_dir/conf/config.alloy -- do not
// hand-edit on the host, it is overwritten on the next converge. Edit
// infra/ansible/roles/ops/files/config.alloy instead -- files/, NOT templates/: `copy:` only ever
// searches a role's files/ dir, so an edit made to a templates/ copy silently never deploys
// (tests/test_infra_alloy_series.py reads this files/ path). Structurally this mirrors
// infra/ansible/roles/capture/files/config.alloy (spec 00068 D6) and infra/nas/config.alloy (spec
// 00049 Role B) -- same unix exporter / textfile / scrape / remote_write / journal-logs pipeline --
// with two deliberate divergences, each called out in the comments below. The
// node's credentials are NOT in this file: they arrive as environment variables from a rendered,
// 0600, never-committed secrets file (alloy-secrets.env.j2, see infra/ops/README.md), read here via
// the `sys.env(...)` stdlib function; no hand-placed copy exists anywhere.
//
// Plain `copy:`, not `template:` -- every value below is a literal, so there is nothing for Jinja2
// to substitute, and Alloy's `stage.template` blocks further down use Go template `{{ }}` syntax
// that Jinja2 would fail on; a full-body `{% raw %}` wrap would silently emit a future
// `{{ ops_something }}` as a literal string. If per-host parameterisation is ever needed, switch
// this task to `template:` then, and scope `{% raw %}` to the `stage.template` blocks alone.

// ---- Host metrics -------------------------------------------------------------------------
// The three alternate-path RO mounts (alloy-compose.yaml.j2: /proc->/host/proc, /sys->/host/sys,
// /->/host/root) let this exporter see the ops host's own /proc, /sys and rootfs without colliding
// with Alloy's own container /proc//sys.
//
// DIVERGENCE 2 (user/group + rootfs): the NAS mounts /:/host/root:ro and keeps `filesystem` in
// set_collectors for its rootfs-based free-disk-space reading, while running Alloy as a dedicated
// non-secret-owning uid (1031, not the key-owning 1000) to keep that mount from exposing its 0600
// rrsync pull keys (T0030). Ops replicates the SAME shape -- mount /:/host/root:ro, keep
// `filesystem` -- because free disk space is wanted here too (this host holds the overlay
// writer's tree, the panel, and the liquidations archive; the local rsync mirrors it also held
// are retired since T0058 -- canonical trees are read over NFS now, and the `sync_nas_archive` key
// pair went with that channel). Running Alloy as a user whose home COULD hold a private key would
// let the /host/root mount read it directly, no escalation needed at all, defeating the protection
// this comment claims to replicate. (The
// RECONCILED_SOURCE channel is not an ops-side private key at all: its private half lives on the
// NAS; ops holds only a forced-command `authorized_keys` PUBLIC entry, which is not secret
// material.) Alloy here instead runs as the dedicated `zcrypto-alloy` system user (nologin,
// created by the role, uid/gid looked up via `getent` -- alloy-compose.yaml.j2's `user:`), which
// owns nothing under /home/deploy/.ssh -- this MIRRORS the NAS's uid-1031 choice, not merely
// resembles it. `group_add` (alloy-compose.yaml.j2) is the host's real numeric systemd-journal
// gid, derived at converge time via `getent` (tasks/main.yml), NOT a named entry: Docker resolves
// a NAMED group_add entry against the CONTAINER's own /etc/group, not the host's, and the upstream
// grafana/alloy image ships only `alloy:x:473:` -- no `systemd-journal` entry -- so a literal name
// here would never resolve and the container would fail to start. This grants read of the WHOLE
// system journal, read-only -- broader than the units the pipeline keeps (below), but strictly
// telemetry-class data. (The docker-socket group_add this used to sit alongside is gone: the
// socket mount + `discovery.docker` retired with the docker log path, spec 00068 D6 -- the
// liquidations poller now ships its own logs directly, and Alloy's own container logs reach
// the node through this same journal mount instead.)
prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "loadavg", "meminfo", "filesystem", "netdev", "textfile"]

  // Docker's per-container veth and bridge devices stay at the source: no rule reads
  // them, and the network panels would plot each one.
  netdev {
    device_exclude = "^(veth|br-)"
  }

  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"

  textfile {
    // The textfiles of roles/ops's timers and of access_ops's zaccess-probe-ops, which runs in the
    // same play and writes here too.
    // alloy-compose.yaml.j2 mounts that host directory read-only at this exact
    // container path -- literal "/textfile", exactly like the NAS's, not a templated
    // ops_textfile_dir -- because this string names the CONTAINER's view of the mount, not the
    // host path.
    directory = "/textfile"
  }
}

// ---- Container metrics: intentionally NOT collected on ops, either -------------------------
// DIVERGENCE 1 (cadvisor): the NAS omits cadvisor because it SIGSEGVs on Synology DSM's
// cgroup-less kernel, taking down all of Alloy -- that rationale does NOT apply here: the ops node
// is Debian with a normal cgroup hierarchy, so cadvisor would simply work. It is still left out,
// omitted BY CHOICE here, not by DSM constraint: this task's job is the timers' textfile series +
// host metrics reaching Grafana (spec D1), container CPU/mem is not part of that gate, and adding
// cadvisor's series would eat into the active-series budget the spec flags as an open risk. A
// future task can add it deliberately if a container-level gate ever needs it.

// ---- App metrics: the liquidations poller's own /metrics endpoint ----------------------------
// Static scrape target, not discovery (spec 00069 D3): the poller container publishes `/metrics`
// on a host-loopback port (compose.yaml.j2's `127.0.0.1:9103:9103`), so there is nothing to
// discover -- a fixed target is simpler and carries no docker-socket dependency. `job_name` is set
// EXPLICITLY (cold-review M6): Alloy otherwise defaults `job` to the component's own path, and the
// rollout's `up{job="liquidations_app"}` check would then query a label value that does not exist.
prometheus.scrape "liquidations_app" {
  targets         = [{"__address__" = "127.0.0.1:9103"}]
  job_name        = "liquidations_app"
  forward_to      = [prometheus.remote_write.grafana.receiver]
  scrape_interval = "60s"
}

// ---- Scrape -> remote_write ------------------------------------------------------------------
prometheus.exporter.self "alloy" {}

prometheus.scrape "host" {
  targets         = array.concat(prometheus.exporter.unix.host.targets, prometheus.exporter.self.alloy.targets)
  forward_to      = [prometheus.remote_write.grafana.receiver]
  scrape_interval = "60s"
}

// T0083 mutual watchdog, Grafana half (spec 00122 D7): the zcrypto-hcio-watchdog rule pages off this scrape of
// the dead-man service. The project's READ-ONLY key goes as a bearer token, read like the path from
// alloy-secrets.env, so a changed key reaches this scrape only through the container's recreate.
prometheus.scrape "healthchecks" {
  targets = [{
    "__address__" = "zcrypto-hc.zhaow.me",
  }]
  scheme          = "https"
  metrics_path    = sys.env("HC_METRICS_PATH")
  bearer_token    = sys.env("HC_READONLY_KEY")
  forward_to      = [prometheus.remote_write.grafana.receiver]
  scrape_interval = "60s"
}

prometheus.remote_write "grafana" {
  // `host="ops"` on every metric this component ships -- without it, no metric on this host
  // carries a `host` label at all (the `host` label the logs pipeline attaches below, in
  // loki.relabel "journal_units", is Loki-only and never reaches Prometheus), so
  // `infra/grafana/alerts.yaml`'s "Ops · node load high" rule
  // (`node_load1{host="ops"}`) selects nothing and can never fire.
  //
  // UPDATE (spec 00069 D7): the NAS's config.alloy now ALSO sets `host="nas"` -- this paragraph
  // used to explain why it deliberately did not, and that reasoning is recorded here for the
  // history, but it no longer describes what either file does. The original worry: adding a label
  // to an EXISTING, already-live series changes that series' identity in Prometheus (the old
  // series ends, a new one begins), and the NAS used to ship
  // `zcrypto_reconcile_residual_gap_seconds_total`, which
  // `infra/grafana/alerts.yaml`'s "Reconciler · residual gap increased (permanent loss)" rule
  // watches through `increase(...[1h]) > 0 and resets(...[1h]) == 0` -- a series-identity change
  // underneath `increase()` can read as a value jump with no corresponding `resets()`, i.e. a
  // FALSE permanent-data-loss page. That risk is now moot: the overlay writer moved to ops (spec
  // 00054 D2) and the NAS's own copy of that family was deleted at the 2026-07-16 cutover (ops's
  // copy alone carries `host="ops"`, distinguishing the two hosts' series exactly as this comment
  // used to promise), so no currently-published NAS series sits under an `increase()`/`resets()`
  // rule. Spec D7's owner accepted the remaining, smaller seam -- `node_load1`/`up`/etc. changing
  // identity at the labeling moment -- as a known cost at an attended window where a false page is
  // cheap to dismiss.
  external_labels = {
    host = "ops",
  }

  endpoint {
    name = "mon"
    url  = sys.env("MON_PROM_URL")

    basic_auth {
      username = sys.env("MON_PROM_USERNAME")
      password = sys.env("MON_PROM_PASSWORD")
    }
  }
}

// ---- Logs: the host journal -- the zcrypto systemd jobs AND Alloy's own container -------------
// Two sources share this one journal reader: the zcrypto-*.service units the regex below names run
// their work as an ephemeral `docker run --rm` ATTACHED to the unit, so container output and the
// orchestration script's OWN lines (host-side echoes, such as archive-pull.sh.j2's gate warning, with
// no other transport) land in the unit's journal; and Alloy's OWN container logs, via the journald
// logging driver (alloy-compose.yaml.j2), with no docker-socket path left to carry them. Delivery is
// bounded upstream by journald's per-service rate limit (Debian default RateLimitBurst=10000 per
// RateLimitIntervalSec=30s), which drops lines before Alloy sees them. The host keeps a persistent
// journal, mounted read-only at /host/journal by alloy-compose.yaml.j2.
//
// The liquidations poller (compose service `liquidations`) is deliberately NOT kept here: it now
// ships its OWN logs straight to the node's Loki (--ship-logs, spec 00068 D3/T6) rather than through
// Alloy at all, so it needs no transport on this host's telemetry stack any more.
loki.relabel "journal_units" {
  // Rules-only component: `forward_to` is a required argument, but nothing streams THROUGH this
  // component -- loki.source.journal below consumes its exported rules via `relabel_rules`.
  forward_to = []

  // KEEP the zcrypto units' journal lines (source 1: __journal__systemd_unit) OR Alloy's own
  // journald-driver stream (source 2: __journal_container_name = grafana-alloy, the container_name
  // the alloy compose service sets) -- everything else on the host journal (sshd, cron, dockerd,
  // ...) stays local.
  rule {
    source_labels = ["__journal__systemd_unit", "__journal_container_name"]
    separator     = ";"
    regex         = "zcrypto-(archive-pull|verify-replay|verified-replay|panel-materialize|tape-bars|vintage-record|vintage-derive)\\.service;.*|.*;grafana-alloy"
    action        = "keep"
  }

  // Unit name minus ".service" -> the `container` label. For the zcrypto units this yields
  // e.g. "zcrypto-archive-pull" -- the label loki.process "parse" below's
  // `{container=~"zcrypto-.*"}` selector keys on, so these streams get parsed (level label, app
  // timestamp) with no selector change. Alloy's journald-driver entries carry
  // _SYSTEMD_UNIT=docker.service (journald stamps the SENDING process's unit -- dockerd), so this
  // rule sets container="docker" for them, which the next rule overwrites -- that is why the
  // order below is load-bearing.
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(.+)\\.service"
    target_label  = "container"
    replacement   = "$1"
  }

  // Alloy's own stream -> container="alloy" (the parse stage below's `{container="alloy"}`
  // selector keys on this). MUST come after the unit-name rule above -- relabel rules apply in
  // order, each seeing the previous rule's output, and the unit-name rule must run first wherever
  // both fields could ever be populated on the same stream.
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "grafana-alloy"
    target_label  = "container"
    replacement   = "alloy"
  }

  // `host="ops"`, exactly like the metrics path's external_labels above -- one label scheme
  // across both. KNOWN, BENIGN divergence from that scheme: loki.source.journal below
  // unconditionally injects job="loki.source.journal.zcrypto_units" into its streams, while
  // nothing reads `job` today (every selector and alert keys only on host/container/level).
  rule {
    target_label = "host"
    replacement  = "ops"
  }
}

loki.source.journal "zcrypto_units" {
  // The compose file mounts the host's persistent journal here read-only; journal readers also
  // need the host's /etc/machine-id (mounted alongside) to resolve the current boot's files
  // (/var/log/journal/<machine-id>/...).
  path          = "/host/journal"
  relabel_rules = loki.relabel.journal_units.rules
  forward_to    = [loki.process.parse.receiver]

  // Bound on "lossless": after an Alloy outage this component resumes from its saved cursor, but
  // never reads further back than max_age -- UNSET it defaults to 7h, so an outage longer than
  // that would permanently skip the window between the cursor and now-7h. 48h was sized for the
  // zcrypto units alone (low-volume half-hourly/hourly/daily); this reader now also carries
  // Alloy's own journald-driver stream (00068 D6), so a restart after an outage backfills up to
  // 48h of that too -- still a bounded, one-time replay, not a steady-state cost, so the same
  // ceiling stands.
  max_age       = "48h"
}

// Parse ONCE, here at ingest -- never at query time. Two stages: our Python services' own
// timestamped log line (the zcrypto-*.service units the keep rule above admits), and Alloy's own
// logfmt output.
loki.process "parse" {
  forward_to = [loki.write.mon.receiver]

  // Our Python services: `2026-07-14 13:18:27,562 INFO zcrypto.archive.command [command.py:75] - msg`
  // Scoped by container, so a container with a different format can never be mangled by this regex.
  // NOT `{container="archive-pull"}` -- that is the NAS's container; ops's archive-pull is a
  // systemd unit, not a container, so that selector matched NOTHING here and this whole stage was
  // dead: no `level` label on any ops stream, no ERROR-logs alert possible (T0060). Every named
  // `zcrypto-*` job emits the same zcrypto Python-logging line shape this stage's regex parses.
  // The liquidations poller used to feed this stage too (its docker-path container label was
  // "liquidations"), but it now ships its own logs directly to the node's Loki (--ship-logs, spec
  // 00068 D3/T6) rather than through Alloy at all, so `liquidations` is dropped from the selector
  // below -- keeping a dead alternative that can never match would be the T0051 trap one level up.
  stage.match {
    selector = "{container=~\"zcrypto-.*\"}"

    stage.regex {
      expression = "^(?P<ts>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2},\\d{3}) (?P<level>[A-Z]+) (?P<rest>.*)$"
    }

    stage.timestamp {
      source   = "ts"
      format   = "2006-01-02 15:04:05,000"
      location = "UTC"
      // "skip", NOT the default "fudge": lines that fail the stage.regex above -- the runner
      // scripts' bare echoes, rsync stderr, docker-client errors, Python tracebacks -- have no `ts`
      // in the extracted map, and "fudge" rewrites their timestamp to the stream's LAST PARSED app
      // timestamp +1ns. For a unit whose failure path emits only unparsed lines, that time-warps the
      // failure up to a run's interval into the past, interleaving it into the PREVIOUS run's output
      // and hiding it from any short-window Explore view or alert. "skip" keeps the journal/docker
      // capture time -- the correct emission time -- for non-matching lines; matching lines still get
      // the app timestamp.
      action_on_failure = "skip"
    }

    stage.template {
      source   = "level"
      template = "{{ ToUpper .Value }}"
    }

    stage.labels {
      values = { level = "level" }
    }

    stage.output {
      source = "rest"
    }
  }

  // Alloy's own logs are logfmt: `ts=<t> level=<lvl> msg="<text>" k=v k=v ...`, arriving via the
  // journald logging driver (00068 D6). `{container="alloy"}` matches because the journal_units
  // container-name rule above relabels CONTAINER_NAME=grafana-alloy to container="alloy".
  stage.match {
    selector = "{container=\"alloy\"}"

    stage.logfmt {
      mapping = { "level" = "" }
    }

    stage.template {
      source   = "level"
      template = "{{ if eq .Value \"warn\" }}WARNING{{ else if eq .Value \"fatal\" }}CRITICAL{{ else }}{{ ToUpper .Value }}{{ end }}"
    }

    stage.labels {
      values = { level = "level" }
    }

    // No stage.output: the line ships UNMODIFIED. Unlike the old regex-and-reassemble approach,
    // this keeps every logfmt attribute in the body (msg= plus whatever k=v pairs followed), and a
    // non-logfmt line (a panic, a bare traceback) simply passes through with no `level` label rather
    // than being mangled by a stage that assumed logfmt shape.
  }

  // Alloy's finished node evaluation, one line per component at every start or reload, reports no event.
  stage.match {
    selector            = "{container=\"alloy\", level=\"INFO\"} |= \"msg=\\\"finished node evaluation\\\"\""
    action              = "drop"
    drop_counter_reason = "alloy_node_evaluation"
  }

  // A day the tape-bars sweep failed is ERROR, a condition another rule pages is WARNING. An echo that copies a record the
  // CLI also logs is dropped, since the record ships levelled.
  stage.match {
    selector = "{container=\"zcrypto-tape-bars\", level=\"\"} |~ \"^  ERROR \""

    stage.static_labels {
      values = { level = "ERROR" }
    }
  }

  stage.match {
    selector = "{container=\"zcrypto-tape-bars\", level=\"\"} |~ \"^(days_written|head)=\""

    stage.static_labels {
      values = { level = "INFO" }
    }
  }

  stage.match {
    selector = "{container=\"zcrypto-verified-replay\", level=\"\"} |~ \"^\\\\S+  (MISMATCH|VALIDATION-FAILED)|^verified-replay: journal \""

    stage.static_labels {
      values = { level = "WARNING" }
    }
  }

  stage.match {
    selector = "{container=\"zcrypto-verified-replay\", level=\"\"} |~ \"^\\\\S+  (ok \\\\(worst |failed cycle \\\\()|^replayed \\\\d+ success record|^no journaled cycles found$|^verified-replay: capped at \""

    stage.static_labels {
      values = { level = "INFO" }
    }
  }

  stage.match {
    selector            = "{container=\"zcrypto-verify-replay\", level=\"\"} |~ \"^(verify-replay census |replayed \\\\d+ hour\\\\(s\\\\): )\""
    action              = "drop"
    drop_counter_reason = "typer_echo_copy"
  }

  stage.match {
    selector = "{container=\"zcrypto-verify-replay\", level=\"\"} |~ \"^AUDIT MISMATCH  \""

    stage.static_labels {
      values = { level = "WARNING" }
    }
  }

  stage.match {
    selector            = "{container=\"zcrypto-archive-pull\", level=\"\"} |~ \"^trade backfill complete \""
    action              = "drop"
    drop_counter_reason = "typer_echo_copy"
  }
}

loki.write "mon" {
  endpoint {
    url = sys.env("MON_LOKI_URL")

    basic_auth {
      username = sys.env("MON_LOKI_USERNAME")
      password = sys.env("MON_LOKI_PASSWORD")
    }
  }
}
