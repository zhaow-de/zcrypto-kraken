# Rendered by the `hc` Ansible role at {{ hc_compose_dir }}/hc.env, root-only; edit
# infra/ansible/roles/hc/templates/hc.env.j2 and re-converge. The names are the clone's, read by hc/settings.py.
# Compose interpolates a `$` in a value here, so no vaulted value's shape admits one.
SECRET_KEY={{ hc_secret_key }}
SITE_ROOT=https://{{ hc_hostname }}
ALLOWED_HOSTS={{ hc_hostname }}
DEBUG=False
DB_NAME=/data/hc.sqlite
# Caddy sets X-Forwarded-Proto, replacing what the client sent.
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
LOG_FORMAT=json
EMAIL_HOST={{ hc_email_host }}
EMAIL_PORT={{ hc_email_port }}
EMAIL_USE_TLS=True
EMAIL_HOST_USER={{ hc_email_host_user }}
EMAIL_HOST_PASSWORD={{ hc_email_host_password }}
DEFAULT_FROM_EMAIL={{ hc_email_from }}
