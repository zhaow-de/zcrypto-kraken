// Grafana Alloy config for the dead-man node (zcrypto-hc). Installed by the `hc` role with `ansible.builtin.copy`
// at /etc/alloy/config.alloy, so edit this file, never the host's copy.
//
// Native Alloy, the apt package under systemd: it reads the host's real /proc, /sys and journal, and writes to the
// observability node alone, through that node's edge with the fleet credential /etc/default/alloy carries, with no
// filter.
//
// EDITING NOTE -- tests read assignments out of this file: keep every config key the first non-space token on
// exactly one line.

// ---- Host metrics -------------------------------------------------------------------------------
// The textfile directory is where the reboot check writes reboot.prom and the backup its gauge.
prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "loadavg", "meminfo", "filesystem", "netdev", "textfile"]

  textfile {
    directory = "/var/lib/zcrypto-node-textfile"
  }
}

prometheus.exporter.self "alloy" {}

// No `job_name` here: exporter targets carry their own `job` label (integrations/unix, integrations/self).
prometheus.scrape "host" {
  targets         = array.concat(prometheus.exporter.unix.host.targets, prometheus.exporter.self.alloy.targets)
  forward_to      = [prometheus.remote_write.mon.receiver]
  scrape_interval = "60s"
}

// ---- remote_write -------------------------------------------------------------------------------
prometheus.remote_write "mon" {
  external_labels = {
    host = "zcrypto-hc",
  }

  endpoint {
    url = sys.env("MON_PROM_URL")

    basic_auth {
      username = sys.env("MON_PROM_USERNAME")
      password = sys.env("MON_PROM_PASSWORD")
    }
  }
}

// ---- Logs: the node's units and the container ---------------------------------------------------
// The clone logs through the journald driver, so its lines are keyed by the container's name, never by the
// zcrypto-hc unit, whose attached `docker compose up` copies the same lines. Caddy is left out: its lines carry a
// request's URI, and with it the ping key.
loki.relabel "journal_units" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit", "__journal_container_name"]
    separator     = ";"
    regex         = "(alloy|zcrypto-hc-selfcheck|zcrypto-sqlite-backup|zcrypto-reboot-check)\\.service;.*|.*;zcrypto-hc"
    action        = "keep"
  }

  // The container-name rule below overwrites this label for the clone's stream, whose unit is docker.service: keep it after this one.
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(.+)\\.service"
    target_label  = "container"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__journal_container_name"]
    regex         = "zcrypto-hc"
    target_label  = "container"
    replacement   = "hc"
  }

  rule {
    target_label = "host"
    replacement  = "zcrypto-hc"
  }
}

loki.source.journal "hc_units" {
  relabel_rules = loki.relabel.journal_units.rules
  forward_to    = [loki.process.parse.receiver]
  // Unset, an outage longer than 7h skips the journal between the cursor and now-7h for good.
  max_age       = "48h"
}

loki.process "parse" {
  forward_to = [loki.write.mon.receiver]

  // The clone writes one JSON object per record. Before anything else reads a line, the path segment after each
  // `/ping/` is written over: a server error's record names its request's path, and with it the project's ping key,
  // or a check's UUID in the other ping form. A check's UUID in any other path is kept. The parse alone sets no
  // label, so the labels stage lifts `level`.
  stage.match {
    selector = "{container=\"hc\"}"

    stage.replace {
      expression = "/ping/([A-Za-z0-9_-]+)"
      replace    = "REDACTED"
    }

    stage.json {
      expressions = { level = "level" }
    }

    stage.labels {
      values = { level = "level" }
    }
  }

  // Alloy's own logs are logfmt with a `level` key, parsed as on the fleet's other hosts.
  stage.match {
    selector = "{container=\"alloy\"}"

    stage.logfmt {
      mapping = { "level" = "" }
    }

    stage.template {
      source   = "level"
      template = "{{ if eq .Value \"warn\" }}WARNING{{ else if eq .Value \"fatal\" }}CRITICAL{{ else }}{{ ToUpper .Value }}{{ end }}"
    }

    stage.labels {
      values = { level = "level" }
    }
  }

  // The sources below print no level and take one by the shape they print: a self-check's failing line and a client that
  // abandoned a ping's body are warnings, each explaining a page the dead-man raises for the ping it cost; the backup's
  // lines carry their own level word; uWSGI's arm names each line it prints, so a crash's line of another text ships
  // with no level.
  stage.match {
    selector = "{container=\"zcrypto-hc-selfcheck\", level=\"\"} |~ \"^selfcheck: .*(=FAIL|-> not pinging|-> ping failed|-> healthy, and no ping URL is set)\""

    stage.static_labels {
      values = { level = "WARNING" }
    }
  }

  stage.match {
    selector = "{container=\"zcrypto-hc-selfcheck\", level=\"\"} |~ \"^selfcheck: \""

    stage.static_labels {
      values = { level = "INFO" }
    }
  }

  stage.match {
    selector = "{container=\"zcrypto-sqlite-backup\", level=\"\"} |~ \"^\\\\d{4}-\\\\d{2}-\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2},\\\\d{3} ERROR \""

    stage.static_labels {
      values = { level = "ERROR" }
    }
  }

  stage.match {
    selector = "{container=\"zcrypto-sqlite-backup\", level=\"\"} |~ \"^\\\\d{4}-\\\\d{2}-\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2},\\\\d{3} INFO \""

    stage.static_labels {
      values = { level = "INFO" }
    }
  }

  stage.match {
    selector = "{container=\"zcrypto-sqlite-backup\", level=\"\"} |~ \"^ \\\\S+ Cop(ying|ied) \""

    stage.static_labels {
      values = { level = "INFO" }
    }
  }

  stage.match {
    selector = "{container=\"hc\", level=\"\"} |~ \"\\\\[uwsgi-cron\\\\] |^Deleted api_ping \\\\d+, \""

    stage.static_labels {
      values = { level = "INFO" }
    }
  }

  stage.match {
    selector = "{container=\"alloy\", level=\"\"} |~ \"^Alloy starting in \""

    stage.static_labels {
      values = { level = "INFO" }
    }
  }

  stage.match {
    selector = "{container=\"hc\", level=\"\"} |~ \"^\\\\[uwsgi-body-read\\\\] Error reading \""

    stage.static_labels {
      values = { level = "WARNING" }
    }
  }

  stage.match {
    selector = "{container=\"hc\", level=\"\"} |~ \"^(\\\\*\\\\*\\\\* (Starting uWSGI |Operational MODE: |uWSGI is running in multiple interpreter mode)|!!! no internal routing support|\\\\[uWSGI\\\\] getting INI configuration from |\\\\[uwsgi-daemons\\\\] (spawning|stopping daemon) |spawned uWSGI (master process|worker \\\\d+) |uwsgi socket \\\\d+ bound to |WSGI app \\\\d+ \\\\(mountpoint=|worker \\\\d+ buried after |goodbye to uWSGI|SIGINT/SIGTERM received|Python (version|main interpreter initialized)|python threads support enabled|chdir\\\\(\\\\) to |(clock source|compiled with version|current working directory|detected binary path|detected max file descriptor number|detected number of CPU cores|lock engine|machine|nodename|os|thunder lock): |mapped \\\\d+ bytes |setting request body buffering size |your (memory page size|mercy for graceful operations|server socket listen backlog) |running .exec:)\""

    stage.static_labels {
      values = { level = "INFO" }
    }
  }

  stage.match {
    selector = "{container=\"hc\", level=\"\"} |~ \"^(Operations to perform:$|Running migrations:$|  Apply all migrations: |  Applying \\\\S+\\\\.\\\\.\\\\. OK$|  No migrations to apply\\\\.$)\""

    stage.static_labels {
      values = { level = "INFO" }
    }
  }
}

loki.write "mon" {
  endpoint {
    url = sys.env("MON_LOKI_URL")

    basic_auth {
      username = sys.env("MON_LOKI_USERNAME")
      password = sys.env("MON_LOKI_PASSWORD")
    }
  }
}
