// Grafana Alloy config for the observability node (zcrypto-mon). Installed by the `mon` role with
// `ansible.builtin.copy` at /etc/alloy/config.alloy, so edit this file, never the host's copy.
//
// Native Alloy, the apt package under systemd: it reads the host's real /proc, /sys and journal, and
// writes to the node's own Prometheus and Loki on loopback, with no credential and no filter: a fleet
// host that ships to the node goes through Caddy with a credential, and this one is on the node.
//
// EDITING NOTE -- test suites pull assignments out of this file by PREFIX (`line.strip().startswith(<key>)`).
// Keep every config key the first non-space token on exactly one line.

// ---- Host metrics -------------------------------------------------------------------------------
// The textfile directory is where the role's reboot check writes reboot.prom, the pending-reboot flag.
prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "loadavg", "meminfo", "filesystem", "netdev", "textfile"]

  textfile {
    directory = "/var/lib/zcrypto-node-textfile"
  }
}

prometheus.exporter.self "alloy" {}

// No `job_name` here: exporter targets carry their own `job` label (integrations/unix, integrations/self).
prometheus.scrape "host" {
  targets         = array.concat(prometheus.exporter.unix.host.targets, prometheus.exporter.self.alloy.targets)
  forward_to      = [prometheus.remote_write.mon.receiver]
  scrape_interval = "60s"
}

// ---- The node's own services --------------------------------------------------------------------
// Grafana, Prometheus and Loki each serve /metrics on loopback. The node's rules select them by these
// job names.
prometheus.scrape "grafana" {
  targets         = [{"__address__" = "127.0.0.1:3000"}]
  job_name        = "grafana"
  forward_to      = [prometheus.remote_write.mon.receiver]
  scrape_interval = "60s"
}

prometheus.scrape "prometheus" {
  targets         = [{"__address__" = "127.0.0.1:9090"}]
  job_name        = "prometheus"
  forward_to      = [prometheus.remote_write.mon.receiver]
  scrape_interval = "60s"
}

prometheus.scrape "loki" {
  targets         = [{"__address__" = "127.0.0.1:3100"}]
  job_name        = "loki"
  forward_to      = [prometheus.remote_write.mon.receiver]
  scrape_interval = "60s"
}

// ---- remote_write -------------------------------------------------------------------------------
prometheus.remote_write "mon" {
  external_labels = {
    host = "zcrypto-mon",
  }

  endpoint {
    url = "http://127.0.0.1:9090/api/v1/write"
  }
}

// ---- Logs: the node's units ---------------------------------------------------------------------
loki.relabel "journal_units" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(grafana-server|prometheus|loki|caddy|alloy|zcrypto-mon-selfcheck|zcrypto-reboot-check)\\.service"
    action        = "keep"
  }

  // Unit name minus ".service" -> `container`, the label every fleet log selector keys on.
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(.+)\\.service"
    target_label  = "container"
    replacement   = "$1"
  }

  rule {
    target_label = "host"
    replacement  = "zcrypto-mon"
  }
}

loki.source.journal "mon_units" {
  relabel_rules = loki.relabel.journal_units.rules
  forward_to    = [loki.process.parse.receiver]
  // Unset, an outage longer than 7h skips the journal between the cursor and now-7h for good.
  max_age       = "48h"
}

loki.process "parse" {
  forward_to = [loki.write.mon.receiver]

  // Grafana, Prometheus, Loki and Alloy log logfmt with a `level` key. A line of another shape renders
  // an empty level, which the labels stage drops; the blocks at the end of this component level two
  // such shapes.
  stage.match {
    selector = "{container=~\"grafana-server|prometheus|loki|alloy\"}"

    stage.logfmt {
      mapping = { "level" = "" }
    }

    stage.template {
      source   = "level"
      template = "{{ if eq .Value \"warn\" }}WARNING{{ else if eq .Value \"fatal\" }}CRITICAL{{ else }}{{ ToUpper .Value }}{{ end }}"
    }

    stage.labels {
      values = { level = "level" }
    }
  }

  // Caddy logs JSON with a `level` key.
  stage.match {
    selector = "{container=\"caddy\"}"

    stage.json {
      expressions = { level = "level" }
    }

    stage.template {
      source   = "level"
      template = "{{ if eq .Value \"warn\" }}WARNING{{ else if eq .Value \"fatal\" }}CRITICAL{{ else }}{{ ToUpper .Value }}{{ end }}"
    }

    stage.labels {
      values = { level = "level" }
    }
  }

  // Four shapes Grafana or Loki log at ERROR or WARNING that report no fault, each named by its drop reason, are dropped
  // rather than shipped at a level their text does not print.
  stage.match {
    selector            = "{container=~\"grafana-server|loki\", level=~\"ERROR|WARNING\"} |~ \"\\\\berr(or)?=\\\"(?:[^\\\"\\\\\\\\]|\\\\\\\\.)*context canceled\\\"\""
    action              = "drop"
    drop_counter_reason = "cancelled_context"
  }

  stage.match {
    selector            = "{container=\"grafana-server\", level=\"ERROR\"} |= \"msg=\\\"Request Completed\\\"\" |= \" path=/apis/quotas.grafana.app/\" |= \" status=501 \""
    action              = "drop"
    drop_counter_reason = "quotas_api_unserved"
  }

  stage.match {
    selector            = "{container=\"grafana-server\", level=\"ERROR\"} |= \"logger=ngalert.notifier \" |= \" receiver= \" |= \"msg=\\\"Missing notification reason\\\"\""
    action              = "drop"
    drop_counter_reason = "contact_point_test"
  }

  stage.match {
    selector            = "{container=\"grafana-server\", level=\"ERROR\"} |= \"msg=\\\"plugin process exited\\\"\" |= \"signal: terminated\""
    action              = "drop"
    drop_counter_reason = "plugin_stopped_with_grafana"
  }

  // Loki's querier on a scheduler connection a cancelled query closed: the EOF notifying the scheduler and the health
  // check on the closing connection. A scheduler failure that reports nothing but that EOF is dropped with them.
  stage.match {
    selector            = "{container=\"loki\", level=\"ERROR\"} |= \"msg=\\\"error notifying scheduler about finished query\\\"\" |= \" err=EOF \""
    action              = "drop"
    drop_counter_reason = "scheduler_notify_eof"
  }

  stage.match {
    selector            = "{container=\"loki\", level=\"ERROR\"} |= \"msg=\\\"error health checking\\\"\" |= \"err=\\\"rpc error: code = Canceled desc = grpc: the client connection is closing\\\"\""
    action              = "drop"
    drop_counter_reason = "health_check_connection_closing"
  }

  // Alloy's finished node evaluation, one line per component at every start or reload, reports no event.
  stage.match {
    selector            = "{container=\"alloy\", level=\"INFO\"} |= \"msg=\\\"finished node evaluation\\\"\""
    action              = "drop"
    drop_counter_reason = "alloy_node_evaluation"
  }

  // The self-check prints one line a run and no level; a failing probe's line explains the page its missing ping raises.
  stage.match {
    selector = "{container=\"zcrypto-mon-selfcheck\", level=\"\"} |~ \"^selfcheck: .*(=FAIL|-> not pinging|-> ping failed|-> healthy, and no ping URL is set)\""

    stage.static_labels {
      values = { level = "WARNING" }
    }
  }

  stage.match {
    selector = "{container=\"zcrypto-mon-selfcheck\", level=\"\"} |~ \"^selfcheck: \""

    stage.static_labels {
      values = { level = "INFO" }
    }
  }

  // Three shapes the node's own services print with no level at a start: Alloy's start line and Caddy's environment
  // dump report the start; the curl wait for Prometheus and Loki before Grafana starts warns, its last failure leaving
  // Grafana down for the self-check to page.
  stage.match {
    selector = "{container=\"alloy\", level=\"\"} |~ \"^Alloy starting in \""

    stage.static_labels {
      values = { level = "INFO" }
    }
  }

  stage.match {
    selector = "{container=\"caddy\", level=\"\"} |~ \"^[A-Za-z_][A-Za-z0-9_.]*=\""

    stage.static_labels {
      values = { level = "INFO" }
    }
  }

  stage.match {
    selector = "{container=\"grafana-server\", level=\"\"} |~ \"^curl: \\\\(\\\\d+\\\\) \""

    stage.static_labels {
      values = { level = "WARNING" }
    }
  }
}

loki.write "mon" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}
