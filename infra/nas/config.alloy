// Grafana Alloy config for the NAS telemetry stack (spec 00049, Role B / Task 3), adapted from
// the VPS design in docs/specs/00043-observability-design.md for plain `docker compose` under
// Container Manager -- no ansible/systemd rendering here, this file is committed and mounted
// read-only as-is (infra/nas/compose.yaml). Grafana Cloud credentials are NOT in this file: they
// arrive as environment variables from an out-of-band, 0600, never-committed secrets file
// (infra/nas/alloy-secrets.env, see infra/nas/README.md), read here via the `sys.env(...)` stdlib
// function.

// ---- Host metrics -------------------------------------------------------------------------
// The three alternate-path RO mounts (compose.yaml: /proc->/host/proc, /sys->/host/sys,
// /->/host/root) let this exporter see the NAS host's own /proc, /sys and rootfs without
// colliding with Alloy's own container /proc//sys. set_collectors is explicit -- only these six
// run, matching the requested host telemetry (system load, network IO, free disk space) plus the
// Role B gate metrics via the textfile collector.
prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "loadavg", "meminfo", "filesystem", "netdev", "textfile"]

  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"

  textfile {
    // Task 2's `zcrypto engine gate-export` writes gate.prom here after every journal pull
    // (infra/nas/pull-entrypoint.sh); mounted read-only into this container at the same path the
    // archive-pull container mounts read-write (compose.yaml).
    directory = "/textfile"
  }
}

// ---- Container metrics: intentionally NOT collected on the NAS -----------------------------
// cadvisor is incompatible with Synology DSM: it SIGSEGVs (nil-pointer in
// manager.createContainerLocked) because DSM's kernel lacks the CPU cgroup hierarchy cadvisor
// walks, and the panic takes down ALL of Alloy. So no `prometheus.exporter.cadvisor` here --
// container CPU/mem is not scraped on the NAS. Host metrics (load / netdev / disk-free -- the
// requested telemetry) come from the unix exporter above.

// ---- Scrape -> remote_write ------------------------------------------------------------------
// T0048 defect 1's SD-wedge detection RETIRED with `discovery.docker` (00068 D6/D8): the alert it
// fed (zcrypto-alloy-docker-sd-wedged) watched prometheus_sd_refresh_duration_seconds_count /
// _failures_total, which only this self-scrape ever produced -- with no discovery.* component left
// on this host, neither series exists any more, and both are gone from the keep-regex below too (a
// keep-list entry for a series that cannot exist is the T0051 trap). The drop rule below no longer
// discards process_* (00069 T7): that family moved to the keep-list below, admitted explicitly --
// the same six names the app daemons' own endpoints publish elsewhere on the fleet (spec D4/D5),
// widened uniformly to every host rather than trimmed per-job. Alloy's own `client_golang`
// ProcessCollector on Linux is a SUPERSET of `prometheus_client`'s six (it also publishes at least
// `process_virtual_memory_max_bytes`), so the six-name keep-list is a deliberate SUBSET FILTER on
// Alloy's own self-scrape: all six Python names exist in client_golang too (no
// admitted-but-unpublishable gap), and the extras it drops (e.g. `process_virtual_memory_max_bytes`)
// are unwanted here. This target's surviving contribution is therefore its own `up` plus those six
// process_* names, nothing more.
prometheus.exporter.self "alloy" {}

prometheus.scrape "host" {
  targets         = array.concat(prometheus.exporter.unix.host.targets, prometheus.exporter.self.alloy.targets)
  forward_to      = [prometheus.remote_write.grafana.receiver]
  scrape_interval = "60s"
}

prometheus.remote_write "grafana" {
  // `host="nas"` on every metric this component ships (spec 00069 D7 -- the owner's call to fold
  // this in now rather than wait for the dashboards iteration). Previously this Alloy set NO host
  // label at all, deliberately: see infra/ansible/roles/ops/files/config.alloy's remote_write
  // comment for the full history of why, and why that reasoning no longer blocks adding it here
  // (the one series it protected, zcrypto_reconcile_residual_gap_seconds_total, no longer
  // publishes from the NAS -- the writer moved to ops at spec 00054 D2). `external_labels` is
  // applied component-wide, before the write_relabel_config blocks below run -- so it does not
  // touch the drop/keep pair (both match on `__name__` only), same as every other host's copy of
  // this comment.
  external_labels = {
    host = "nas",
  }

  endpoint {
    url = sys.env("GRAFANA_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_PROM_USERNAME")
      password = sys.env("GRAFANA_PROM_PASSWORD")
    }

    // Series minimization is a design principle, not an afterthought (00043): drop Alloy's own
    // `go_*`/`alloy_*` self-metrics first -- this is NOT a no-op: `prometheus.exporter.self "alloy"`
    // above feeds the `host` scrape, and this rule is what keeps its internals out of remote_write.
    // Then keep-only the host/container/gate/process series this stack actually wants. Target:
    // comfortably under 1k active series. This list is provisional -- confirm the actual
    // active-series count at the NAS deploy shakedown and trim/extend here. The six ProcessCollector
    // families (00069 T7) are Alloy's own -- no daemon runs on the NAS, so there is no app or
    // logship series to admit here, unlike the capture/ops hosts.
    write_relabel_config {
      source_labels = ["__name__"]
      regex         = "go_.*|alloy_.*"
      action        = "drop"
    }

    write_relabel_config {
      source_labels = ["__name__"]
      regex         = "up|node_load1|node_load5|node_load15|node_memory_MemTotal_bytes|node_memory_MemAvailable_bytes|node_memory_MemFree_bytes|node_filesystem_avail_bytes|node_filesystem_size_bytes|node_filesystem_free_bytes|node_filesystem_files|node_filesystem_files_free|node_network_receive_bytes_total|node_network_transmit_bytes_total|node_cpu_seconds_total|node_textfile_scrape_error|node_scrape_collector_success|node_scrape_collector_duration_seconds|zcrypto_gate_.*|zcrypto_reconcile_.*|zcrypto_trade_backfill_.*|process_cpu_seconds_total|process_max_fds|process_open_fds|process_resident_memory_bytes|process_start_time_seconds|process_virtual_memory_bytes"
      action        = "keep"
    }
  }
}

// ---- Logs: the host journal -- BOTH containers, via the journald logging driver -------------
// First build on this host (00068 D6/T8): the docker-socket discovery this replaces used to ship
// both containers' logs straight off the Docker API; with the socket mount retired
// (infra/nas/compose.yaml), `archive-pull` and `alloy` now log via the `journald` driver instead,
// and this component reads them back out of the host's journal -- unverified on DSM specifically
// until the D7 rollout's throwaway-container probe. Keep-list, not host-wide, but NOT a narrowing:
// unlike the fleet's other journal readers (capture/ops), which also admit host-side systemd-unit
// lines with no container twin, DSM runs no such units feeding this journal -- both entries below
// are simply the SAME two containers the retired docker-discovery path already shipped (verified
// 2026-07-14: exactly two exist), so this re-derives identical coverage through a different
// transport, not a smaller one.
loki.relabel "journal_units" {
  // Rules-only component: `forward_to` is a required argument, but nothing streams THROUGH this
  // component -- loki.source.journal below consumes its exported rules via `relabel_rules`.
  forward_to = []

  // KEEP only this host's two containers' journald-driver entries -- everything else on the host
  // journal stays local.
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "grafana-alloy|zcrypto-archive-pull"
    action        = "keep"
  }

  // Container-name mapping, preserving the SAME label values the retired docker-discovery path
  // produced (spec 00057's compose-service-name scheme: zcrypto-archive-pull -> archive-pull,
  // grafana-alloy -> alloy) -- so the `container="archive-pull"`/`"alloy"` selectors below, the
  // logs dashboard, and the NAS archive-pull alerts (errors + the dead-man) all continue to select
  // the same streams with NO re-key.
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "zcrypto-archive-pull"
    target_label  = "container"
    replacement   = "archive-pull"
  }

  rule {
    source_labels = ["__journal_container_name"]
    regex         = "grafana-alloy"
    target_label  = "container"
    replacement   = "alloy"
  }

  // `host="nas"` -- STATIC literal, not `constants.hostname`: under `network_mode: host`
  // (compose.yaml) that would resolve to the DSM's own machine name, not "nas" (cold-review I2) --
  // exactly the trap the capture hosts avoid by genuinely being named `zcrypto`/`zcrypto-red`. This
  // matches the LITERAL "nas" the retired docker-discovery path's `host` rule used to set (spec
  // 00049), so every existing selector/alert keyed on `host="nas"` survives unchanged.
  rule {
    target_label = "host"
    replacement  = "nas"
  }
}

loki.source.journal "containers" {
  // The compose file mounts the host's VOLATILE journal here read-only (compose.yaml: measured --
  // /var/log/journal, the persistent path capture/ops read, is EMPTY on DSM, so /run/log/journal is
  // the only path that actually carries entries); journal readers also need the host's
  // /etc/machine-id (mounted alongside) to resolve the current boot's files.
  path          = "/host/journal"
  relabel_rules = loki.relabel.journal_units.rules
  forward_to    = [loki.process.parse.receiver]

  // After an Alloy outage this component resumes from its saved cursor but never reads further
  // back than max_age -- UNSET it defaults to 7h. 48h matches the fleet's other journal readers
  // (capture/ops): cheap for these two low-volume streams, lossless up to a 48h Alloy outage;
  // beyond that the skipped window survives only in the host's (volatile!) journal, never in Loki.
  max_age       = "48h"
}

// Parse ONCE, here at ingest -- never at query time. A dashboard regex over the raw line is fragile
// (it silently blanks or mangles any line that does not match, and every panel re-implements it);
// doing it here means the line reaches Loki already clean, `level` is a real label the UI can filter
// on, and the entry timestamp is the application's own rather than the journal's capture time.
//
// Why the line looks duplicated in Grafana today: Python's logging writes `<asctime> <LEVEL> ...`
// into the message, while Loki independently stores an entry timestamp and derives `detected_level`.
// Grafana renders its own two columns beside the app's copy of the same two fields. (The `,562` vs
// `.563` is NOT a locale artifact -- `logging.Formatter.default_msec_format` is the literal `'%s,%03d'`
// in CPython, and the ~2 h offset is just the browser rendering UTC in Europe/Berlin.)
loki.process "parse" {
  forward_to = [loki.write.grafana.receiver]

  // Our Python services: `2026-07-14 13:18:27,562 INFO zcrypto.archive.command [command.py:75] - msg`
  // Scoped by container, so a container with a different format can never be mangled by this regex.
  stage.match {
    selector = "{container=\"archive-pull\"}"

    stage.regex {
      expression = "^(?P<ts>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2},\\d{3}) (?P<level>[A-Z]+) (?P<rest>.*)$"
    }

    // Use the app's own stamp as the entry time (Go layout; the comma is literal). A line the regex
    // missed keeps `ts` unset, and the stage's default action_on_failure ("fudge") then stamps it at
    // the stream's last good timestamp + 1ns -- NOT at the journal's arrival time. That is the
    // behaviour we want: a traceback's continuation lines land immediately after the record they
    // belong to instead of being scattered. Either way the line is passed through, never dropped.
    stage.timestamp {
      source   = "ts"
      format   = "2006-01-02 15:04:05,000"
      location = "UTC"
    }

    // Canonical level spelling = Python's own level names (DEBUG/INFO/WARNING/ERROR/CRITICAL), so
    // the dashboard matches what `zcrypto` prints on a console. Already uppercase here; the stage is
    // kept so the two sources are normalised in the same place and cannot drift.
    stage.template {
      source   = "level"
      template = "{{ ToUpper .Value }}"
    }

    stage.labels {
      values = { level = "level" }
    }

    // Emit only the part Grafana does NOT already show: logger, source location, message.
    stage.output {
      source = "rest"
    }
  }

  // Alloy's own logs are logfmt: `ts=<t> level=<lvl> msg="<text>" k=v k=v ...`, arriving via the
  // journald logging driver (00068 D6/T8). `{container="alloy"}` matches because the
  // journal_units container-name rule above relabels CONTAINER_NAME=grafana-alloy to
  // container="alloy".
  stage.match {
    selector = "{container=\"alloy\"}"

    stage.logfmt {
      mapping = { "level" = "" }
    }

    // Alloy speaks logfmt with short, lowercase names (`warn`, `info`). Uppercasing alone is not
    // enough: it would yield WARN beside Python's WARNING — two spellings of one level, so a
    // dropdown selection would silently miss half the lines. Map onto Python's names.
    stage.template {
      source   = "level"
      template = "{{ if eq .Value \"warn\" }}WARNING{{ else if eq .Value \"fatal\" }}CRITICAL{{ else }}{{ ToUpper .Value }}{{ end }}"
    }

    stage.labels {
      values = { level = "level" }
    }

    // No stage.output: the line ships UNMODIFIED. Unlike the old regex-and-reassemble approach,
    // this keeps every logfmt attribute in the body (msg= plus whatever k=v pairs followed), and a
    // non-logfmt line (a panic, a bare traceback) simply passes through with no `level` label rather
    // than being mangled by a stage that assumed logfmt shape.
  }
}

loki.write "grafana" {
  endpoint {
    url = sys.env("GRAFANA_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_LOKI_USERNAME")
      password = sys.env("GRAFANA_LOKI_PASSWORD")
    }
  }
}
