{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "1000"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(infra/scripts/probe-with-vaulted-key.sh --probes:*)",
      "Bash(./infra/scripts/probe-with-vaulted-key.sh --probes:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr list:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-remote:*)",
      "Bash(kraken ticker:*)",
      "Bash(kraken ohlc:*)",
      "Bash(kraken orderbook:*)",
      "Bash(kraken orderbook-l3:*)",
      "Bash(kraken trades:*)",
      "Bash(kraken spreads:*)",
      "Bash(kraken pairs:*)",
      "Bash(kraken assets:*)",
      "Bash(kraken balance:*)",
      "Bash(kraken extended-balance:*)",
      "Bash(kraken trade-balance:*)",
      "Bash(kraken volume:*)",
      "Bash(kraken ledgers:*)",
      "Bash(kraken trades-history:*)",
      "Bash(kraken positions:*)",
      "Bash(kraken open-orders:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/memo-guard.sh pre-write",
            "timeout": 10,
            "statusMessage": "memo-guard: freshness check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/memo-guard.sh post-read",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/memo-guard.sh post-write",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-mv-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
