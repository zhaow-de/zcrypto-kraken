# Copy this file to `.env` (already gitignored) and fill in your Kraken API credentials.
# Create the key at Kraken -> Settings -> API as a READ-ONLY key. Enable ONLY:
#   Query closed orders & trades, Query ledger entries, Export data, Query funds.
# Leave OFF: Query open orders & trades, WebSocket interface, and every create/modify/cancel
# order + deposit + withdraw permission. A trade-scoped key comes later, at Phase 6 -- keep
# it out of `.env` until then.

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
