# Copy this file to `.env` (already gitignored) and fill in your Kraken API credentials.
# Create the key at Kraken -> Settings -> API. Start with a READ-ONLY key (no trade, no
# withdraw permissions). A trade-scoped key comes later, at Phase 6 -- keep it out of
# `.env` until then.

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
